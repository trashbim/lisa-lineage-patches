From 41239dbd587f8b0404db0100ca16e446a9c41f7a Mon Sep 17 00:00:00 2001
From: trashbim <xmdbsmzdsjcbfmdjc@gmail.com>
Date: Sat, 17 Oct 2026 01:59:50 +0300
Subject: [PATCH 21/22] sm8350-common: Optimize graphics with Skia Vulkan and
 tune VM dirty ratios

- Enable ro.hwui.use_vulkan=true for Skia Vulkan rendering backend
- Enable renderthread.skia.reduceopstasksplitting=true and debug.sf.enable_gl_backpressure=1
- Enable debug.renderengine.graphite.precompile=true
- Lower vm.dirty_ratio to 10 and vm.dirty_background_ratio to 5 to avoid UFS I/O stalls
- Disable periodic F2FS iostat logging to save CPU wakeups

Change-Id: I0dac38a3f2ff5b8bbf0d44af3388d0f464cd988d
---
 rootdir/bin/init.kernel.post_boot-yupik.sh | 9 +++++++++
 rootdir/etc/init.qti.kernel.rc             | 2 ++
 vendor.prop                                | 6 ++++++
 3 files changed, 17 insertions(+)

diff --git a/rootdir/bin/init.kernel.post_boot-yupik.sh b/rootdir/bin/init.kernel.post_boot-yupik.sh
index 71e1559..6d619e2 100755
--- a/rootdir/bin/init.kernel.post_boot-yupik.sh
+++ b/rootdir/bin/init.kernel.post_boot-yupik.sh
@@ -111,6 +111,15 @@ function configure_memory_parameters() {
 	echo 100 > /proc/sys/vm/swappiness
 	echo 10 > /proc/sys/vm/stat_interval
 	echo 60 > /proc/sys/vm/vfs_cache_pressure
+	echo 10 > /proc/sys/vm/dirty_ratio
+	echo 5 > /proc/sys/vm/dirty_background_ratio
+
+	# Disable periodic F2FS iostat logging to eliminate kernel wakeups
+	for node in /sys/fs/f2fs/*/iostat_enable; do
+		if [ -f "$node" ]; then
+			echo 0 > "$node"
+		fi
+	done
 
         echo 20 > /proc/sys/vm/watermark_scale_factor
 
diff --git a/rootdir/etc/init.qti.kernel.rc b/rootdir/etc/init.qti.kernel.rc
index cc8d917..a22cff8 100644
--- a/rootdir/etc/init.qti.kernel.rc
+++ b/rootdir/etc/init.qti.kernel.rc
@@ -72,6 +72,8 @@ on property:sys.boot_completed=1
     write /proc/sys/vm/page-cluster 0
     write /proc/sys/vm/stat_interval 10
     write /proc/sys/vm/vfs_cache_pressure 60
+    write /proc/sys/vm/dirty_ratio 10
+    write /proc/sys/vm/dirty_background_ratio 5
 
     start kernel-post-boot
 
diff --git a/vendor.prop b/vendor.prop
index 8d3d501..4921acf 100644
--- a/vendor.prop
+++ b/vendor.prop
@@ -319,3 +319,9 @@ ro.lmk.swap_util_max=90
 # Bionic / Scudo: Disable GWP-ASan sampling in production to eliminate malloc wrapper overhead
 persist.libc.debug.gwp_asan.process_sampling.system_default=0
 persist.libc.debug.gwp_asan.process_sampling.app_default=0
+
+# Graphics & Rendering: Use Skia Vulkan backend for UI and optimize pipeline
+ro.hwui.use_vulkan=true
+renderthread.skia.reduceopstasksplitting=true
+debug.sf.enable_gl_backpressure=1
+debug.renderengine.graphite.precompile=true
-- 
2.56.0

