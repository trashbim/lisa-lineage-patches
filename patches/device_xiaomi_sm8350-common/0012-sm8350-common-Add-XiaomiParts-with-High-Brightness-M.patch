@@ -0,0 +1,81 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.settings.device.battery;
+
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.content.SharedPreferences;
+import android.os.BatteryManager;
+import android.util.Log;
+
+import androidx.preference.PreferenceManager;
+
+import org.lineageos.settings.device.FileUtils;
+
+public final class BypassChargingController {
+    public static final String TAG = "BypassChargingCtrl";
+    public static final String NODE_INPUT_SUSPEND = "/sys/class/qcom-battery/input_suspend";
+    public static final String PREF_BYPASS_CHARGING = "pref_bypass_charging";
+    public static final String ACTION_BYPASS_CHARGING_CHANGED =
+            "org.lineageos.settings.device.ACTION_BYPASS_CHARGING_CHANGED";
+    public static final String EXTRA_BYPASS_CHARGING_STATE = "extra_bypass_charging_state";
+
+    private BypassChargingController() {
+    }
+
+    public static boolean isSupported() {
+        return FileUtils.fileExists(NODE_INPUT_SUSPEND);
+    }
+
+    public static boolean isPowerConnected(Context context) {
+        Intent intent = context.registerReceiver(null, new IntentFilter(Intent.ACTION_BATTERY_CHANGED));
+        if (intent == null) {
+            return false;
+        }
+        int plugged = intent.getIntExtra(BatteryManager.EXTRA_PLUGGED, 0);
+        return plugged == BatteryManager.BATTERY_PLUGGED_AC
+                || plugged == BatteryManager.BATTERY_PLUGGED_USB
+                || plugged == BatteryManager.BATTERY_PLUGGED_WIRELESS;
+    }
+
+    public static boolean isEnabled(Context context) {
+        String val = FileUtils.readOneLine(NODE_INPUT_SUSPEND);
+        if (val != null) {
+            return "1".equals(val.trim());
+        }
+        SharedPreferences prefs = PreferenceManager.getDefaultSharedPreferences(context);
+        return prefs.getBoolean(PREF_BYPASS_CHARGING, false);
+    }
+
+    public static void setEnabled(Context context, boolean enable) {
+        if (!isSupported()) {
+            Log.w(TAG, "Bypass charging node not found on this device");
+            return;
+        }
+
+        boolean success = FileUtils.writeLine(NODE_INPUT_SUSPEND, enable ? "1" : "0");
+        if (success) {
+            SharedPreferences prefs = PreferenceManager.getDefaultSharedPreferences(context);
+            prefs.edit().putBoolean(PREF_BYPASS_CHARGING, enable).apply();
+
+            Intent serviceIntent = new Intent(context, BypassChargingMonitorService.class);
+            if (enable) {
+                context.startService(serviceIntent);
+            } else {
+                context.stopService(serviceIntent);
+            }
+
+            Intent broadcast = new Intent(ACTION_BYPASS_CHARGING_CHANGED);
+            broadcast.putExtra(EXTRA_BYPASS_CHARGING_STATE, enable);
+            broadcast.setPackage(context.getPackageName());
+            context.sendBroadcast(broadcast);
+            Log.d(TAG, "Bypass charging set to " + enable);
+        } else {
+            Log.e(TAG, "Failed to write to input_suspend: " + enable);
+        }
+    }
+}
