+
+import org.lineageos.settings.device.battery.BypassChargingController;
+import org.lineageos.settings.device.hbm.HbmController;
+
+public class PartsFragment extends SettingsBasePreferenceFragment
+        implements Preference.OnPreferenceChangeListener {
+
+    private SwitchPreferenceCompat mHbmPreference;
+    private SwitchPreferenceCompat mBypassChargingPreference;
+
+    private final BroadcastReceiver mStateReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            String action = intent.getAction();
+            if (HbmController.ACTION_HBM_CHANGED.equals(action) && mHbmPreference != null) {
+                boolean state = intent.getBooleanExtra(HbmController.EXTRA_HBM_STATE, false);
+                mHbmPreference.setChecked(state);
+            } else if (BypassChargingController.ACTION_BYPASS_CHARGING_CHANGED.equals(action)
+                    && mBypassChargingPreference != null) {
+                boolean state = intent.getBooleanExtra(
+                        BypassChargingController.EXTRA_BYPASS_CHARGING_STATE, false);
+                mBypassChargingPreference.setChecked(state);
+            }
+        }
+    };
+
+    @Override
+    public void onCreatePreferences(Bundle savedInstanceState, String rootKey) {
+        setPreferencesFromResource(R.xml.parts_preferences, rootKey);
+
+        mHbmPreference = findPreference(HbmController.PREF_HBM);
+        if (mHbmPreference != null) {
+            if (!HbmController.isSupported()) {
+                PreferenceCategory displayCat = findPreference("category_display");
+                if (displayCat != null) {
+                    getPreferenceScreen().removePreference(displayCat);
+                }
+            } else {
+                mHbmPreference.setChecked(HbmController.isEnabled(getContext()));
+                mHbmPreference.setOnPreferenceChangeListener(this);
+            }
+        }
+
+        mBypassChargingPreference = findPreference(BypassChargingController.PREF_BYPASS_CHARGING);
+        if (mBypassChargingPreference != null) {
+            if (!BypassChargingController.isSupported()) {
+                PreferenceCategory batteryCat = findPreference("category_battery");
+                if (batteryCat != null) {
+                    getPreferenceScreen().removePreference(batteryCat);
+                }
+            } else {
+                mBypassChargingPreference.setChecked(
+                        BypassChargingController.isEnabled(getContext()));
+                mBypassChargingPreference.setOnPreferenceChangeListener(this);
+            }
+        }
+    }
+
+    @Override
+    public void onStart() {
+        super.onStart();
+        IntentFilter filter = new IntentFilter();
+        filter.addAction(HbmController.ACTION_HBM_CHANGED);
+        filter.addAction(BypassChargingController.ACTION_BYPASS_CHARGING_CHANGED);
+        requireContext().registerReceiver(mStateReceiver, filter, Context.RECEIVER_NOT_EXPORTED);
+
+        if (mHbmPreference != null && HbmController.isSupported()) {
+            mHbmPreference.setChecked(HbmController.isEnabled(getContext()));
+        }
+        if (mBypassChargingPreference != null && BypassChargingController.isSupported()) {
+            mBypassChargingPreference.setChecked(BypassChargingController.isEnabled(getContext()));
+        }
+    }
+
+    @Override
+    public void onStop() {
+        try {
+            requireContext().unregisterReceiver(mStateReceiver);
+        } catch (IllegalArgumentException ignored) {
+        }
+        super.onStop();
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        Context context = getContext();
+        if (context == null) {
+            return false;
+        }
+
+        boolean enabled = (Boolean) newValue;
+        if (preference == mHbmPreference) {
+            HbmController.setEnabled(context, enabled);
+            return true;
+        } else if (preference == mBypassChargingPreference) {
+            if (enabled && !BypassChargingController.isPowerConnected(context)) {
+                Toast.makeText(context, R.string.bypass_charging_connect_charger_toast,
+                        Toast.LENGTH_SHORT).show();
+                return false;
+            }
+            BypassChargingController.setEnabled(context, enabled);
+            return true;
+        }
+        return false;
+    }
+}
