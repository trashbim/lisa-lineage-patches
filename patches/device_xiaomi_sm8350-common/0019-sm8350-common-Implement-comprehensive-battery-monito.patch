+    public static void applySpeedProfile(String profile) {
+        if (!FileUtils.fileExists(NODE_RESTRICT_CHG)) {
+            return;
+        }
+
+        switch (profile) {
+            case SPEED_BALANCED:
+                // 2000mA limit (~18W)
+                FileUtils.writeLine(NODE_RESTRICT_CUR, "2000000");
+                FileUtils.writeLine(NODE_RESTRICT_CHG, "1");
+                Log.d(TAG, "Applied balanced charging profile: 2000mA");
+                break;
+            case SPEED_COLD:
+                // 1200mA limit (~10W)
+                FileUtils.writeLine(NODE_RESTRICT_CUR, "1200000");
+                FileUtils.writeLine(NODE_RESTRICT_CHG, "1");
+                Log.d(TAG, "Applied cold charging profile: 1200mA");
+                break;
+            case SPEED_TURBO:
+            default:
+                // Full 33W (no restriction)
