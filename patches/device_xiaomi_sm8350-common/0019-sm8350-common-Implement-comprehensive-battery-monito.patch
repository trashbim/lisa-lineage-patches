+    public static void applyHysteresis(Context context, BatteryTelemetry t) {
+        if (!t.isPlugged) {
+            // If physically unplugged, ensure bypass mode is reset
+            if (t.isBypassed) {
+                BypassChargingController.setEnabled(context, false);
+            }
+            return;
+        }
+
+        if (!isChargeLimitEnabled(context)) {
+            return;
+        }
+
+        int stopThreshold = getStopThreshold(context);
+        int startThreshold = getStartThreshold(context);
+
+        if (t.capacity >= stopThreshold && !t.isBypassed) {
+            Log.i(TAG, "Charge limit reached (" + t.capacity + "% >= " + stopThreshold + "%). Enabling bypass mode.");
+            BypassChargingController.setEnabled(context, true);
+        } else if (t.capacity <= startThreshold && t.isBypassed) {
+            Log.i(TAG, "Charge dropped to restart threshold (" + t.capacity + "% <= " + startThreshold + "%). Resuming charging.");
+            BypassChargingController.setEnabled(context, false);
+        }
+    }
