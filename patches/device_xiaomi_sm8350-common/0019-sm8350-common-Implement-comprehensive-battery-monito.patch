diff --git a/parts/src/org/lineageos/settings/device/battery/BatteryMonitorService.java b/parts/src/org/lineageos/settings/device/battery/BatteryMonitorService.java
new file mode 100644
index 0000000..d90e397
--- /dev/null
+++ b/parts/src/org/lineageos/settings/device/battery/BatteryMonitorService.java
@@ -0,0 +1,125 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.settings.device.battery;
+
+import android.app.Service;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.os.Handler;
+import android.os.IBinder;
+import android.os.Looper;
+import android.util.Log;
+
+public class BatteryMonitorService extends Service {
+    private static final String TAG = "BatteryMonitorService";
+
+    public static final String ACTION_TELEMETRY_UPDATED =
+            "org.lineageos.settings.device.ACTION_TELEMETRY_UPDATED";
+
+    private static final long INTERVAL_CHARGING_MS = 1000;  // 1 second during charge
+    private static final long INTERVAL_BATTERY_MS = 30000;  // 30 seconds on battery
+
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private boolean mIsRunning = false;
+    private static BatteryTelemetry sLatestTelemetry = null;
+
+    private final Runnable mPollRunnable = new Runnable() {
+        @Override
+        public void run() {
+            if (!mIsRunning) {
+                return;
+            }
+
+            try {
+                BatteryTelemetry t = BatteryTelemetry.readCurrentState(BatteryMonitorService.this);
+                sLatestTelemetry = t;
+
+                // 1. Apply charge threshold hysteresis
+                ChargingControlManager.applyHysteresis(BatteryMonitorService.this, t);
+
+                // 2. Log sample if enabled
+                if (ChargingControlManager.isLoggingEnabled(BatteryMonitorService.this)) {
+                    BatteryTelemetryLogger.logSample(t);
+                }
+
+                // 3. Broadcast telemetry update for active UI
+                Intent broadcast = new Intent(ACTION_TELEMETRY_UPDATED);
+                broadcast.setPackage(getPackageName());
+                sendBroadcast(broadcast);
+
+                // 4. Schedule next sample
+                long delay = t.isPlugged ? INTERVAL_CHARGING_MS : INTERVAL_BATTERY_MS;
+                mHandler.postDelayed(this, delay);
+            } catch (Exception e) {
+                Log.e(TAG, "Error in battery monitor loop", e);
+                mHandler.postDelayed(this, INTERVAL_BATTERY_MS);
+            }
+        }
+    };
+
+    private final BroadcastReceiver mPowerReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            String action = intent.getAction();
+            if (Intent.ACTION_POWER_CONNECTED.equals(action) ||
+                Intent.ACTION_POWER_DISCONNECTED.equals(action)) {
+                // Wake up immediately and reschedule with new interval
+                mHandler.removeCallbacks(mPollRunnable);
+                mHandler.post(mPollRunnable);
+            }
+        }
+    };
+
+    public static BatteryTelemetry getLatestTelemetry() {
+        return sLatestTelemetry;
+    }
+
+    @Override
+    public void onCreate() {
+        super.onCreate();
+        mIsRunning = true;
+
+        IntentFilter filter = new IntentFilter();
+        filter.addAction(Intent.ACTION_POWER_CONNECTED);
+        filter.addAction(Intent.ACTION_POWER_DISCONNECTED);
+        registerReceiver(mPowerReceiver, filter, Context.RECEIVER_NOT_EXPORTED);
+
+        // Apply saved speed profile
+        String profile = ChargingControlManager.getSpeedProfile(this);
+        ChargingControlManager.applySpeedProfile(profile);
+
+        mHandler.post(mPollRunnable);
+        Log.i(TAG, "BatteryMonitorService started");
+    }
+
+    @Override
+    public int onStartCommand(Intent intent, int flags, int startId) {
+        if (!mIsRunning) {
+            mIsRunning = true;
+            mHandler.post(mPollRunnable);
+        }
+        return START_STICKY;
+    }
+
+    @Override
+    public void onDestroy() {
+        mIsRunning = false;
+        mHandler.removeCallbacks(mPollRunnable);
+        try {
+            unregisterReceiver(mPowerReceiver);
+        } catch (IllegalArgumentException ignored) {
+        }
+        Log.i(TAG, "BatteryMonitorService stopped");
+        super.onDestroy();
+    }
+
+    @Override
+    public IBinder onBind(Intent intent) {
+        return null;
+    }
+}
diff --git a/parts/src/org/lineageos/settings/device/battery/BatterySettingsFragment.java b/parts/src/org/lineageos/settings/device/battery/BatterySettingsFragment.java
new file mode 100644
index 0000000..1377350
--- /dev/null
+++ b/parts/src/org/lineageos/settings/device/battery/BatterySettingsFragment.java
@@ -0,0 +1,239 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.settings.device.battery;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.net.Uri;
+import android.os.Bundle;
+import android.widget.Toast;
+
+import androidx.core.content.FileProvider;
+import androidx.preference.ListPreference;
+import androidx.preference.Preference;
+import androidx.preference.SwitchPreferenceCompat;
+
+import com.android.settingslib.widget.SettingsBasePreferenceFragment;
+
+import org.lineageos.settings.device.R;
+
+import java.io.File;
+import java.util.Locale;
+
+public class BatterySettingsFragment extends SettingsBasePreferenceFragment
+        implements Preference.OnPreferenceChangeListener, Preference.OnPreferenceClickListener {
+
+    private Preference mLiveDashboardPref;
+    private SwitchPreferenceCompat mChargeLimitEnabledPref;
+    private ListPreference mStopThresholdPref;
+    private ListPreference mStartThresholdPref;
+    private ListPreference mSpeedProfilePref;
+    private SwitchPreferenceCompat mBypassChargingPref;
+    private SwitchPreferenceCompat mLoggingEnabledPref;
+    private Preference mExportLogPref;
+
+    private final BroadcastReceiver mTelemetryReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            if (BatteryMonitorService.ACTION_TELEMETRY_UPDATED.equals(intent.getAction())) {
+                updateDashboard(BatteryMonitorService.getLatestTelemetry());
+            }
+        }
+    };
+
+    @Override
+    public void onCreatePreferences(Bundle savedInstanceState, String rootKey) {
+        setPreferencesFromResource(R.xml.battery_settings, rootKey);
+
+        mLiveDashboardPref = findPreference("pref_live_dashboard");
+        mChargeLimitEnabledPref = findPreference(ChargingControlManager.PREF_CHARGE_LIMIT_ENABLED);
+        mStopThresholdPref = findPreference(ChargingControlManager.PREF_CHARGE_STOP_THRESHOLD);
+        mStartThresholdPref = findPreference(ChargingControlManager.PREF_CHARGE_START_THRESHOLD);
+        mSpeedProfilePref = findPreference(ChargingControlManager.PREF_CHARGE_SPEED_PROFILE);
+        mBypassChargingPref = findPreference(BypassChargingController.PREF_BYPASS_CHARGING);
+        mLoggingEnabledPref = findPreference(ChargingControlManager.PREF_CHARGE_LOGGING_ENABLED);
+        mExportLogPref = findPreference("pref_export_battery_log");
+
+        Context context = requireContext();
+
+        if (mChargeLimitEnabledPref != null) {
+            mChargeLimitEnabledPref.setChecked(ChargingControlManager.isChargeLimitEnabled(context));
+            mChargeLimitEnabledPref.setOnPreferenceChangeListener(this);
+        }
+
+        if (mStopThresholdPref != null) {
+            mStopThresholdPref.setValue(String.valueOf(ChargingControlManager.getStopThreshold(context)));
+            mStopThresholdPref.setOnPreferenceChangeListener(this);
+        }
+
+        if (mStartThresholdPref != null) {
+            mStartThresholdPref.setValue(String.valueOf(ChargingControlManager.getStartThreshold(context)));
+            mStartThresholdPref.setOnPreferenceChangeListener(this);
+        }
+
+        if (mSpeedProfilePref != null) {
+            mSpeedProfilePref.setValue(ChargingControlManager.getSpeedProfile(context));
+            mSpeedProfilePref.setOnPreferenceChangeListener(this);
+        }
+
+        if (mBypassChargingPref != null) {
+            mBypassChargingPref.setChecked(BypassChargingController.isEnabled(context));
+            mBypassChargingPref.setOnPreferenceChangeListener(this);
+        }
+
+        if (mLoggingEnabledPref != null) {
+            mLoggingEnabledPref.setChecked(ChargingControlManager.isLoggingEnabled(context));
+            mLoggingEnabledPref.setOnPreferenceChangeListener(this);
+        }
+
+        if (mExportLogPref != null) {
+            mExportLogPref.setOnPreferenceClickListener(this);
+        }
+
+        // Ensure service is started
+        try {
+            context.startService(new Intent(context, BatteryMonitorService.class));
+        } catch (Exception ignored) {
+        }
+    }
+
+    @Override
+    public void onStart() {
+        super.onStart();
+        IntentFilter filter = new IntentFilter(BatteryMonitorService.ACTION_TELEMETRY_UPDATED);
+        requireContext().registerReceiver(mTelemetryReceiver, filter, Context.RECEIVER_NOT_EXPORTED);
+
+        updateDashboard(BatteryMonitorService.getLatestTelemetry());
+    }
+
+    @Override
+    public void onStop() {
+        try {
+            requireContext().unregisterReceiver(mTelemetryReceiver);
+        } catch (IllegalArgumentException ignored) {
+        }
+        super.onStop();
+    }
+
+    private void updateDashboard(BatteryTelemetry t) {
+        if (mLiveDashboardPref == null) {
+            return;
+        }
+
+        if (t == null) {
+            t = BatteryTelemetry.readCurrentState(getContext());
+        }
+
+        double currentMa = t.currentNowUa / 1000.0;
+        double voltageV = t.voltageNowUv / 1000000.0;
+        double vbusV = t.vbusUv / 1000000.0;
+
+        StringBuilder sb = new StringBuilder();
+
+        if (t.isBypassed) {
+            sb.append("⚡ Режим: Сквозное питание (обход батареи)\n");
+            sb.append(String.format(Locale.US, "🔌 Питание от сети: %.2f В (%s)\n", vbusV, t.protocol));
+            sb.append(String.format(Locale.US, "🔋 Аккумулятор: %d%% (%.2f В)\n", t.capacity, voltageV));
+        } else if (t.isPlugged) {
+            String modeStr = t.turbo33w ? "Mi Turbo Charge (33W 🚀)" :
+                    ("USB-PD / " + t.protocol);
+            sb.append(String.format(Locale.US, "⚡ Режим: %s\n", modeStr));
+            sb.append(String.format(Locale.US, "⚡ Мощность: %.1f Вт (%.0f мА @ %.2f В)\n",
+                    t.powerW, Math.abs(currentMa), voltageV));
+            sb.append(String.format(Locale.US, "🔌 Вход USB Type-C: %.2f В\n", vbusV));
+        } else {
+            sb.append("🔋 Режим: Работа от аккумулятора\n");
+            sb.append(String.format(Locale.US, "📉 Разряд: %.1f Вт (%.0f мА @ %.2f В)\n",
+                    t.powerW, Math.abs(currentMa), voltageV));
+        }
+
+        sb.append(String.format(Locale.US, "🌡 Температура: %.1f °C\n", t.tempC));
+        sb.append(String.format(Locale.US, "❤️ Здоровье: %d%%  •  Циклы: %d", t.soh, t.cycles));
+
+        mLiveDashboardPref.setSummary(sb.toString());
+
+        if (mBypassChargingPref != null) {
+            mBypassChargingPref.setChecked(t.isBypassed);
+        }
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        Context context = getContext();
+        if (context == null) {
+            return false;
+        }
+
+        if (preference == mChargeLimitEnabledPref) {
+            boolean enabled = (Boolean) newValue;
+            ChargingControlManager.setChargeLimitEnabled(context, enabled);
+            return true;
+        } else if (preference == mStopThresholdPref) {
+            int stop = Integer.parseInt((String) newValue);
+            ChargingControlManager.setStopThreshold(context, stop);
+            return true;
+        } else if (preference == mStartThresholdPref) {
+            int start = Integer.parseInt((String) newValue);
+            ChargingControlManager.setStartThreshold(context, start);
+            return true;
+        } else if (preference == mSpeedProfilePref) {
+            String profile = (String) newValue;
+            ChargingControlManager.setSpeedProfile(context, profile);
+            return true;
+        } else if (preference == mBypassChargingPref) {
+            boolean enabled = (Boolean) newValue;
+            if (enabled && !BypassChargingController.isPowerConnected(context)) {
+                Toast.makeText(context, R.string.bypass_charging_connect_charger_toast,
+                        Toast.LENGTH_SHORT).show();
+                return false;
+            }
+            BypassChargingController.setEnabled(context, enabled);
+            return true;
+        } else if (preference == mLoggingEnabledPref) {
+            boolean enabled = (Boolean) newValue;
+            ChargingControlManager.setLoggingEnabled(context, enabled);
+            return true;
+        }
+
+        return false;
+    }
+
+    @Override
+    public boolean onPreferenceClick(Preference preference) {
+        Context context = getContext();
+        if (context == null) {
+            return false;
+        }
+
+        if (preference == mExportLogPref) {
+            File logFile = BatteryTelemetryLogger.getLatestLogFile();
+            if (logFile == null || !logFile.exists() || logFile.length() == 0) {
+                Toast.makeText(context, R.string.export_log_empty_toast, Toast.LENGTH_SHORT).show();
+                return true;
+            }
+
+            try {
+                Uri fileUri = FileProvider.getUriForFile(context,
+                        context.getPackageName() + ".fileprovider", logFile);
+
+                Intent shareIntent = new Intent(Intent.ACTION_SEND);
+                shareIntent.setType("text/csv");
+                shareIntent.putExtra(Intent.EXTRA_STREAM, fileUri);
+                shareIntent.putExtra(Intent.EXTRA_SUBJECT, "Battery Telemetry: " + logFile.getName());
+                shareIntent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+
+                startActivity(Intent.createChooser(shareIntent,
+                        getString(R.string.export_log_chooser_title)));
+            } catch (Exception e) {
+                Toast.makeText(context, "Failed to export: " + e.getMessage(), Toast.LENGTH_LONG).show();
+            }
+            return true;
+        }
+        return false;
+    }
+}
