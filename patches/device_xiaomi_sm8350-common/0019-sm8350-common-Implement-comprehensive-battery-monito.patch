@@ -0,0 +1,141 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.settings.device.battery;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.util.Log;
+
+import androidx.preference.PreferenceManager;
+
+import org.lineageos.settings.device.FileUtils;
+
+public final class ChargingControlManager {
+    private static final String TAG = "ChargingControlMgr";
+
+    public static final String PREF_CHARGE_LIMIT_ENABLED = "pref_charge_limit_enabled";
+    public static final String PREF_CHARGE_STOP_THRESHOLD = "pref_charge_stop_threshold";
+    public static final String PREF_CHARGE_START_THRESHOLD = "pref_charge_start_threshold";
+    public static final String PREF_CHARGE_SPEED_PROFILE = "pref_charge_speed_profile";
+    public static final String PREF_CHARGE_LOGGING_ENABLED = "pref_charge_logging_enabled";
+
+    public static final String NODE_RESTRICT_CUR = "/sys/class/qcom-battery/restrict_cur";
+    public static final String NODE_RESTRICT_CHG = "/sys/class/qcom-battery/restrict_chg";
+
+    public static final String SPEED_TURBO = "turbo";
+    public static final String SPEED_BALANCED = "balanced";
+    public static final String SPEED_COLD = "cold";
+
+    private ChargingControlManager() {
+    }
+
+    public static boolean isChargeLimitEnabled(Context context) {
+        SharedPreferences prefs = PreferenceManager.getDefaultSharedPreferences(context);
+        return prefs.getBoolean(PREF_CHARGE_LIMIT_ENABLED, false);
+    }
+
+    public static void setChargeLimitEnabled(Context context, boolean enabled) {
+        SharedPreferences prefs = PreferenceManager.getDefaultSharedPreferences(context);
+        prefs.edit().putBoolean(PREF_CHARGE_LIMIT_ENABLED, enabled).apply();
+        if (!enabled) {
+            // Restore normal charging if limit is turned off
+            BypassChargingController.setEnabled(context, false);
+        }
+    }
+
+    public static int getStopThreshold(Context context) {
+        SharedPreferences prefs = PreferenceManager.getDefaultSharedPreferences(context);
+        return prefs.getInt(PREF_CHARGE_STOP_THRESHOLD, 80);
+    }
+
+    public static void setStopThreshold(Context context, int threshold) {
+        SharedPreferences prefs = PreferenceManager.getDefaultSharedPreferences(context);
+        prefs.edit().putInt(PREF_CHARGE_STOP_THRESHOLD, threshold).apply();
+    }
+
+    public static int getStartThreshold(Context context) {
+        SharedPreferences prefs = PreferenceManager.getDefaultSharedPreferences(context);
+        return prefs.getInt(PREF_CHARGE_START_THRESHOLD, 75);
+    }
+
+    public static void setStartThreshold(Context context, int threshold) {
+        SharedPreferences prefs = PreferenceManager.getDefaultSharedPreferences(context);
