@@ -0,0 +1,99 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.settings.device.battery;
+
+import android.content.Context;
+import org.lineageos.settings.device.FileUtils;
+
+public final class BatteryTelemetry {
+    public static final String NODE_CAPACITY = "/sys/class/power_supply/battery/capacity";
+    public static final String NODE_CURRENT_NOW = "/sys/class/power_supply/battery/current_now";
+    public static final String NODE_VOLTAGE_NOW = "/sys/class/power_supply/battery/voltage_now";
+    public static final String NODE_TEMP = "/sys/class/power_supply/battery/temp";
+    public static final String NODE_USB_VOLTAGE = "/sys/class/power_supply/usb/voltage_now";
+
+    public static final String NODE_USB_REAL_TYPE = "/sys/class/qcom-battery/usb_real_type";
+    public static final String NODE_PD_VERIFIED = "/sys/class/qcom-battery/pd_verifed";
+    public static final String NODE_FASTCHG_MODE = "/sys/class/qcom-battery/fastchg_mode";
+    public static final String NODE_INPUT_SUSPEND = "/sys/class/qcom-battery/input_suspend";
+    public static final String NODE_SOH = "/sys/class/qcom-battery/soh";
+    public static final String NODE_CYCLE = "/sys/class/qcom-battery/fg1_cycle";
+
+    public int capacity;           // % (0-100)
+    public long currentNowUa;      // microamps (negative or positive depending on charging/discharging)
+    public long voltageNowUv;      // microvolts
+    public double powerW;          // calculated power in Watts
+    public double tempC;           // temperature in Celsius
+    public long vbusUv;            // VBUS voltage in microvolts
+    public String protocol;        // SDP, DCP, QC3.0, PD, etc.
+    public boolean turbo33w;       // True if Xiaomi 33W Charge Pump active
+    public boolean isBypassed;     // True if input_suspend is active
+    public int soh;                // State of Health % (e.g. 95)
+    public int cycles;             // Battery charge cycles
+    public boolean isPlugged;      // True if USB VBUS > 3V
+    public long timestamp;         // System.currentTimeMillis()
+
+    public static BatteryTelemetry readCurrentState(Context context) {
+        BatteryTelemetry t = new BatteryTelemetry();
+        t.timestamp = System.currentTimeMillis();
+
+        t.capacity = readInt(NODE_CAPACITY, 0);
+        t.currentNowUa = readLong(NODE_CURRENT_NOW, 0);
+        t.voltageNowUv = readLong(NODE_VOLTAGE_NOW, 0);
+        
+        long rawTemp = readLong(NODE_TEMP, 0);
+        t.tempC = rawTemp > 0 ? rawTemp / 10.0 : 0.0;
+
+        t.vbusUv = readLong(NODE_USB_VOLTAGE, 0);
+        t.isPlugged = t.vbusUv >= 3000000;
+
+        t.protocol = readString(NODE_USB_REAL_TYPE, "Unknown");
+        int pdVerified = readInt(NODE_PD_VERIFIED, 0);
+        int fastChg = readInt(NODE_FASTCHG_MODE, 0);
+        t.turbo33w = (pdVerified >= 1 && fastChg == 1);
+
+        t.isBypassed = "1".equals(readString(NODE_INPUT_SUSPEND, "0"));
+        t.soh = readInt(NODE_SOH, 100);
+        t.cycles = readInt(NODE_CYCLE, 0);
+
+        // Power calculation in Watts: P = (V * I)
+        double currentA = Math.abs(t.currentNowUa) / 1000000.0;
+        double voltageV = t.voltageNowUv / 1000000.0;
+        t.powerW = Math.round((currentA * voltageV) * 100.0) / 100.0;
+
+        return t;
+    }
+
+    private static int readInt(String path, int fallback) {
+        String val = FileUtils.readOneLine(path);
+        if (val != null) {
+            try {
+                return Integer.parseInt(val.trim());
+            } catch (NumberFormatException ignored) {
+            }
+        }
+        return fallback;
+    }
+
+    private static long readLong(String path, long fallback) {
+        String val = FileUtils.readOneLine(path);
+        if (val != null) {
+            try {
+                return Long.parseLong(val.trim());
+            } catch (NumberFormatException ignored) {
+            }
+        }
+        return fallback;
+    }
+
+    private static String readString(String path, String fallback) {
+        String val = FileUtils.readOneLine(path);
+        if (val != null && !val.trim().isEmpty()) {
+            return val.trim();
+        }
+        return fallback;
+    }
+}
diff --git a/parts/src/org/lineageos/settings/device/battery/BatteryTelemetryLogger.java b/parts/src/org/lineageos/settings/device/battery/BatteryTelemetryLogger.java
new file mode 100644
index 0000000..d187abe
--- /dev/null
+++ b/parts/src/org/lineageos/settings/device/battery/BatteryTelemetryLogger.java
@@ -0,0 +1,110 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.settings.device.battery;
+
+import android.content.Context;
+import android.os.Environment;
+import android.util.Log;
+
+import java.io.File;
+import java.io.FileWriter;
+import java.io.IOException;
+import java.io.PrintWriter;
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.Locale;
+
+public final class BatteryTelemetryLogger {
+    private static final String TAG = "BatteryTelemetryLogger";
+    private static final String CSV_HEADER =
+            "timestamp,soc,current_ma,voltage_v,power_w,temp_c,vbus_v,protocol,turbo_33w,bypass,cycles";
+    private static final long MAX_FILE_SIZE_BYTES = 10 * 1024 * 1024; // 10MB per file
+
+    private static final SimpleDateFormat DATE_FORMAT =
+            new SimpleDateFormat("yyyyMMdd", Locale.US);
+    private static final SimpleDateFormat TIME_FORMAT =
+            new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSS", Locale.US);
+
+    private static final Object LOCK = new Object();
+
+    private BatteryTelemetryLogger() {
+    }
+
+    public static File getLogDirectory() {
+        File sdcard = Environment.getExternalStorageDirectory();
+        File dir = new File(sdcard, "BatteryLogs");
+        if (!dir.exists()) {
+            dir.mkdirs();
+        }
+        return dir;
+    }
+
+    public static File getTodayLogFile() {
+        File dir = getLogDirectory();
+        String dateStr = DATE_FORMAT.format(new Date());
+        return new File(dir, "charge_log_" + dateStr + ".csv");
+    }
+
+    public static File getLatestLogFile() {
+        File dir = getLogDirectory();
+        File[] files = dir.listFiles((d, name) -> name.startsWith("charge_log_") && name.endsWith(".csv"));
+        if (files == null || files.length == 0) {
+            return null;
+        }
+        File latest = files[0];
+        for (File f : files) {
+            if (f.lastModified() > latest.lastModified()) {
+                latest = f;
+            }
+        }
+        return latest;
+    }
+
+    public static void logSample(BatteryTelemetry t) {
+        synchronized (LOCK) {
+            File file = getTodayLogFile();
+            boolean isNewFile = !file.exists() || file.length() == 0;
+
+            if (file.exists() && file.length() > MAX_FILE_SIZE_BYTES) {
+                // File exceeded max size, rotate
+                String rotatedName = "charge_log_" + DATE_FORMAT.format(new Date()) + "_" +
+                        System.currentTimeMillis() + ".csv";
+                file = new File(getLogDirectory(), rotatedName);
+                isNewFile = true;
+            }
+
+            try (PrintWriter pw = new PrintWriter(new FileWriter(file, true))) {
+                if (isNewFile) {
+                    pw.println(CSV_HEADER);
+                }
+
+                String timeStr = TIME_FORMAT.format(new Date(t.timestamp));
+                double currentMa = t.currentNowUa / 1000.0;
+                double voltageV = t.voltageNowUv / 1000000.0;
+                double vbusV = t.vbusUv / 1000000.0;
+
+                String line = String.format(Locale.US,
+                        "%s,%d,%.1f,%.3f,%.2f,%.1f,%.2f,%s,%d,%d,%d",
+                        timeStr,
+                        t.capacity,
+                        currentMa,
+                        voltageV,
+                        t.powerW,
+                        t.tempC,
+                        vbusV,
+                        t.protocol,
+                        t.turbo33w ? 1 : 0,
+                        t.isBypassed ? 1 : 0,
+                        t.cycles
+                );
+                pw.println(line);
+                pw.flush();
+            } catch (IOException e) {
+                Log.e(TAG, "Failed to write battery telemetry sample", e);
+            }
+        }
+    }
+}
diff --git a/parts/src/org/lineageos/settings/device/battery/ChargingControlManager.java b/parts/src/org/lineageos/settings/device/battery/ChargingControlManager.java
