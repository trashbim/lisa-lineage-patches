     public static void setEnabled(Context context, boolean enable) {
-        if (!isSupported()) {
-            Log.w(TAG, "HBM is not supported on this device");
+        SharedPreferences prefs = PreferenceManager.getDefaultSharedPreferences(context);
+        boolean current = prefs.getBoolean(PREF_HBM, false);
+        if (current == enable) {
             return;
         }
 
-        boolean success = FileUtils.writeLine(NODE_HBM, enable ? "1" : "0");
-        if (success) {
-            SharedPreferences prefs = PreferenceManager.getDefaultSharedPreferences(context);
-            prefs.edit().putBoolean(PREF_HBM, enable).apply();
+        ContentResolver resolver = context.getContentResolver();
 
-            Intent serviceIntent = new Intent(context, HbmMonitorService.class);
-            if (enable) {
-                context.startService(serviceIntent);
-            } else {
-                context.stopService(serviceIntent);
+        if (enable) {
