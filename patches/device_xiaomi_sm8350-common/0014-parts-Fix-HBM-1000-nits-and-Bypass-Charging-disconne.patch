diff --git a/parts/src/org/lineageos/settings/device/battery/BypassChargingMonitorService.java b/parts/src/org/lineageos/settings/device/battery/BypassChargingMonitorService.java
index 2104268..a153857 100644
--- a/parts/src/org/lineageos/settings/device/battery/BypassChargingMonitorService.java
+++ b/parts/src/org/lineageos/settings/device/battery/BypassChargingMonitorService.java
@@ -13,20 +13,44 @@ import android.content.IntentFilter;
 import android.os.IBinder;
 import android.util.Log;
 
+import org.lineageos.settings.device.FileUtils;
+
 public class BypassChargingMonitorService extends Service {
     private static final String TAG = "BypassChgMonitor";
+    private static final String NODE_USB_VOLTAGE = "/sys/class/power_supply/usb/voltage_now";
 
     private final BroadcastReceiver mPowerReceiver = new BroadcastReceiver() {
         @Override
         public void onReceive(Context context, Intent intent) {
             if (Intent.ACTION_POWER_DISCONNECTED.equals(intent.getAction())) {
-                Log.d(TAG, "Charger disconnected, resetting bypass charging mode");
-                BypassChargingController.setEnabled(context, false);
-                stopSelf();
+                // When input_suspend is set to 1, Android detects charging stopped and fires ACTION_POWER_DISCONNECTED.
+                // But the physical USB cable is still connected (VBUS is ~5V / >3V).
+                // Only reset bypass charging if the USB cable was physically unplugged (voltage drops below 3V or node missing).
+                if (isPhysicallyDisconnected()) {
+                    Log.d(TAG, "Charger physically disconnected, resetting bypass charging mode");
+                    BypassChargingController.setEnabled(context, false);
+                    stopSelf();
+                } else {
+                    Log.d(TAG, "ACTION_POWER_DISCONNECTED received due to input_suspend, cable still connected");
+                }
             }
         }
     };
 
+    private boolean isPhysicallyDisconnected() {
+        String val = FileUtils.readOneLine(NODE_USB_VOLTAGE);
+        if (val == null) {
+            return true;
+        }
+        try {
+            long voltage = Long.parseLong(val.trim());
+            // Voltage is in microvolts (e.g. 5000000 = 5V). Below 3V means unplugged.
+            return voltage < 3000000;
+        } catch (NumberFormatException e) {
+            return true;
+        }
+    }
+
     @Override
     public void onCreate() {
         super.onCreate();
diff --git a/parts/src/org/lineageos/settings/device/hbm/HbmController.java b/parts/src/org/lineageos/settings/device/hbm/HbmController.java
