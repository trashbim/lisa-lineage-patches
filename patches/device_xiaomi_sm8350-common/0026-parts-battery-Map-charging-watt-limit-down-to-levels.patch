From 832282e024bf47cf4bc2a750eb69e02b885148cc Mon Sep 17 00:00:00 2001
From: trashbim <xmdbsmzdsjcbfmdjc@gmail.com>
Date: Fri, 16 Oct 2026 21:33:57 +0300
Subject: [PATCH 26/26] parts: battery: Map charging watt limit down to levels
 16-20 for 1-10W

Change-Id: I8c5736e02e9013e6afd1559e178488b4d4a71ddb
---
 .../battery/ChargingControlManager.java       | 44 ++++++++++++-------
 1 file changed, 29 insertions(+), 15 deletions(-)

diff --git a/parts/src/org/lineageos/settings/device/battery/ChargingControlManager.java b/parts/src/org/lineageos/settings/device/battery/ChargingControlManager.java
index 6520628..9026f3d 100644
--- a/parts/src/org/lineageos/settings/device/battery/ChargingControlManager.java
+++ b/parts/src/org/lineageos/settings/device/battery/ChargingControlManager.java
@@ -139,30 +139,44 @@ public final class ChargingControlManager {
                     FileUtils.writeLine(NODE_CONSTANT_CHARGE_CURRENT, String.valueOf(targetCurrentUa));
                 }
 
-                // Map requested watts to thermal mitigation level (0-15)
-                // Level 15 = 2.5A (cap ~10W)
-                // Level 13 = 3.5A (~14W)
-                // Level 10 = 5.0A (~20W)
-                // Level 6  = 7.0A (~28W)
+                // Map requested watts to thermal mitigation level (0-20)
+                // Level 20 = 0.5A (~2.1W)
+                // Level 19 = 1.0A (~4.2W)
+                // Level 18 = 1.5A (~6.3W)
+                // Level 17 = 2.0A (~8.4W)
+                // Level 16 = 2.5A (~10.5W)
+                // Level 15 = 3.0A (~12.6W)
+                // Level 14 = 3.5A (~14.7W)
+                // Level 13 = 4.0A (~16.8W)
+                // Level 12 = 4.5A (~18.9W)
+                // Level 11 = 5.0A (~21.0W)
                 int thermalLevel;
-                if (watts <= 10) {
-                    thermalLevel = 15;
+                if (watts <= 2) {
+                    thermalLevel = 20;
+                } else if (watts <= 4) {
+                    thermalLevel = 19;
+                } else if (watts <= 6) {
+                    thermalLevel = 18;
+                } else if (watts <= 8) {
+                    thermalLevel = 17;
+                } else if (watts <= 10) {
+                    thermalLevel = 16;
                 } else if (watts <= 12) {
-                    thermalLevel = 14;
+                    thermalLevel = 15;
                 } else if (watts <= 14) {
-                    thermalLevel = 13;
+                    thermalLevel = 14;
                 } else if (watts <= 16) {
-                    thermalLevel = 12;
+                    thermalLevel = 13;
                 } else if (watts <= 18) {
-                    thermalLevel = 11;
+                    thermalLevel = 12;
                 } else if (watts <= 20) {
-                    thermalLevel = 10;
+                    thermalLevel = 11;
                 } else if (watts <= 24) {
-                    thermalLevel = 8;
+                    thermalLevel = 9;
                 } else if (watts <= 28) {
-                    thermalLevel = 6;
+                    thermalLevel = 7;
                 } else {
-                    thermalLevel = 4;
+                    thermalLevel = 5;
                 }
 
                 if (FileUtils.fileExists(NODE_CHARGE_CONTROL_LIMIT)) {
-- 
2.56.0

