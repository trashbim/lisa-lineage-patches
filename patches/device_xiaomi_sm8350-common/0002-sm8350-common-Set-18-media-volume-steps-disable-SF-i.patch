From b9bc719ffca17c3602d48c2cb8b930c4db8a5215 Mon Sep 17 00:00:00 2001
From: Valera <valera@example.com>
Date: Fri, 18 Sep 2026 23:20:57 +0300
Subject: [PATCH 2/7] sm8350-common: Set 18 media volume steps, disable SF idle
 drop, disable QC logging

Change-Id: Ic106efff98637f4b80e4239c4ebc80a2f5404420
---
 vendor.prop | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/vendor.prop b/vendor.prop
index d5dd376..95199ff 100644
--- a/vendor.prop
+++ b/vendor.prop
@@ -181,7 +181,7 @@ debug.sf.high_fps_early_phase_offset_ns=-4000000
 debug.sf.high_fps_late_app_phase_offset_ns=1000000
 debug.sf.high_fps_late_sf_phase_offset_ns=-4000000
 debug.sf.latch_unsignaled=1
-debug.sf.set_idle_timer_ms=3000
+debug.sf.set_idle_timer_ms=0
 persist.sys.sf.color_mode=0
 persist.sys.sf.native_mode=258
 ro.hardware.egl=adreno
@@ -283,3 +283,11 @@ wifi.aware.interface=wifi-aware0
 
 # Zygote
 zygote.critical_window.minute=10
+
+# Media Volume Steps (18 levels)
+ro.config.media_vol_steps=18
+
+# Disable Qualcomm background verbose logging daemons
+persist.vendor.verbose_logging_enabled=false
+persist.vendor.service.bdroid.snooplog=false
+persist.vendor.service.bdroid.fwsnoop=false
-- 
2.55.0

