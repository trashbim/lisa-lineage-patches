index 0000000..945c190
--- /dev/null
+++ b/parts/src/org/lineageos/settings/device/battery/BypassChargingController.java
@@ -0,0 +1,95 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.settings.device.battery;
+
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.content.SharedPreferences;
+import android.os.BatteryManager;
+import android.util.Log;
+
+import androidx.preference.PreferenceManager;
+
+import org.lineageos.settings.device.FileUtils;
+
+public final class BypassChargingController {
+    public static final String TAG = "BypassChargingCtrl";
+    public static final String NODE_INPUT_SUSPEND = "/sys/class/qcom-battery/input_suspend";
+    public static final String NODE_USB_VOLTAGE = "/sys/class/power_supply/usb/voltage_now";
+    public static final String PREF_BYPASS_CHARGING = "pref_bypass_charging";
+    public static final String ACTION_BYPASS_CHARGING_CHANGED =
+            "org.lineageos.settings.device.ACTION_BYPASS_CHARGING_CHANGED";
+    public static final String EXTRA_BYPASS_CHARGING_STATE = "extra_bypass_charging_state";
+
+    private BypassChargingController() {
+    }
+
+    public static boolean isSupported() {
+        return FileUtils.fileExists(NODE_INPUT_SUSPEND);
+    }
+
+    public static boolean isPowerConnected(Context context) {
+        String val = FileUtils.readOneLine(NODE_USB_VOLTAGE);
+        if (val != null) {
+            try {
+                if (Long.parseLong(val.trim()) >= 3000000) {
+                    return true;
+                }
+            } catch (NumberFormatException ignored) {
+            }
+        }
+        Intent intent = context.registerReceiver(null, new IntentFilter(Intent.ACTION_BATTERY_CHANGED));
+        if (intent == null) {
+            return false;
+        }
+        int plugged = intent.getIntExtra(BatteryManager.EXTRA_PLUGGED, 0);
+        return plugged == BatteryManager.BATTERY_PLUGGED_AC
+                || plugged == BatteryManager.BATTERY_PLUGGED_USB
+                || plugged == BatteryManager.BATTERY_PLUGGED_WIRELESS;
+    }
+
+    public static boolean isEnabled(Context context) {
+        String val = FileUtils.readOneLine(NODE_INPUT_SUSPEND);
+        if (val != null) {
+            return "1".equals(val.trim());
+        }
+        SharedPreferences prefs = PreferenceManager.getDefaultSharedPreferences(context);
+        return prefs.getBoolean(PREF_BYPASS_CHARGING, false);
+    }
+
+    public static void setEnabled(Context context, boolean enable) {
+        if (!isSupported()) {
+            Log.w(TAG, "Bypass charging node not found on this device");
+            return;
+        }
+
+        boolean success = FileUtils.writeLine(NODE_INPUT_SUSPEND, enable ? "1" : "0");
+        if (success) {
+            SharedPreferences prefs = PreferenceManager.getDefaultSharedPreferences(context);
+            prefs.edit().putBoolean(PREF_BYPASS_CHARGING, enable).apply();
+
+            try {
+                Intent serviceIntent = new Intent(context, BypassChargingMonitorService.class);
+                if (enable) {
+                    context.startService(serviceIntent);
+                } else {
+                    context.stopService(serviceIntent);
+                }
+            } catch (Exception e) {
+                Log.e(TAG, "Failed to start/stop BypassChargingMonitorService", e);
+            }
+
+            Intent broadcast = new Intent(ACTION_BYPASS_CHARGING_CHANGED);
+            broadcast.putExtra(EXTRA_BYPASS_CHARGING_STATE, enable);
+            broadcast.setPackage(context.getPackageName());
+            context.sendBroadcast(broadcast);
+            Log.d(TAG, "Bypass charging set to " + enable);
+        } else {
+            Log.e(TAG, "Failed to write to input_suspend: " + enable);
+        }
+    }
+}
diff --git a/parts/src/org/lineageos/settings/device/battery/BypassChargingMonitorService.java b/parts/src/org/lineageos/settings/device/battery/BypassChargingMonitorService.java
new file mode 100644
index 0000000..a153857
--- /dev/null
+++ b/parts/src/org/lineageos/settings/device/battery/BypassChargingMonitorService.java
@@ -0,0 +1,82 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.settings.device.battery;
+
+import android.app.Service;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.os.IBinder;
+import android.util.Log;
+
+import org.lineageos.settings.device.FileUtils;
+
+public class BypassChargingMonitorService extends Service {
+    private static final String TAG = "BypassChgMonitor";
+    private static final String NODE_USB_VOLTAGE = "/sys/class/power_supply/usb/voltage_now";
+
+    private final BroadcastReceiver mPowerReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            if (Intent.ACTION_POWER_DISCONNECTED.equals(intent.getAction())) {
+                // When input_suspend is set to 1, Android detects charging stopped and fires ACTION_POWER_DISCONNECTED.
+                // But the physical USB cable is still connected (VBUS is ~5V / >3V).
+                // Only reset bypass charging if the USB cable was physically unplugged (voltage drops below 3V or node missing).
+                if (isPhysicallyDisconnected()) {
+                    Log.d(TAG, "Charger physically disconnected, resetting bypass charging mode");
+                    BypassChargingController.setEnabled(context, false);
+                    stopSelf();
+                } else {
+                    Log.d(TAG, "ACTION_POWER_DISCONNECTED received due to input_suspend, cable still connected");
+                }
+            }
+        }
+    };
+
+    private boolean isPhysicallyDisconnected() {
+        String val = FileUtils.readOneLine(NODE_USB_VOLTAGE);
+        if (val == null) {
+            return true;
+        }
+        try {
+            long voltage = Long.parseLong(val.trim());
+            // Voltage is in microvolts (e.g. 5000000 = 5V). Below 3V means unplugged.
+            return voltage < 3000000;
+        } catch (NumberFormatException e) {
+            return true;
+        }
+    }
+
+    @Override
+    public void onCreate() {
+        super.onCreate();
+        IntentFilter filter = new IntentFilter();
+        filter.addAction(Intent.ACTION_POWER_DISCONNECTED);
+        registerReceiver(mPowerReceiver, filter);
+        Log.d(TAG, "BypassChargingMonitorService started");
+    }
+
+    @Override
+    public int onStartCommand(Intent intent, int flags, int startId) {
+        return START_STICKY;
+    }
+
+    @Override
+    public void onDestroy() {
+        try {
+            unregisterReceiver(mPowerReceiver);
+        } catch (IllegalArgumentException ignored) {
+        }
+        Log.d(TAG, "BypassChargingMonitorService stopped");
+        super.onDestroy();
+    }
+
+    @Override
+    public IBinder onBind(Intent intent) {
+        return null;
+    }
+}
diff --git a/parts/src/org/lineageos/settings/device/battery/BypassChargingTileService.java b/parts/src/org/lineageos/settings/device/battery/BypassChargingTileService.java
new file mode 100644
index 0000000..f8e324e
--- /dev/null
+++ b/parts/src/org/lineageos/settings/device/battery/BypassChargingTileService.java
@@ -0,0 +1,75 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.settings.device.battery;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.service.quicksettings.Tile;
+import android.service.quicksettings.TileService;
+import android.widget.Toast;
+
+import org.lineageos.settings.device.R;
+
+public class BypassChargingTileService extends TileService {
+
+    private final BroadcastReceiver mReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            if (BypassChargingController.ACTION_BYPASS_CHARGING_CHANGED.equals(intent.getAction())) {
+                updateTileState(intent.getBooleanExtra(
+                        BypassChargingController.EXTRA_BYPASS_CHARGING_STATE, false));
+            }
+        }
+    };
+
+    @Override
+    public void onStartListening() {
+        super.onStartListening();
+        IntentFilter filter = new IntentFilter(BypassChargingController.ACTION_BYPASS_CHARGING_CHANGED);
+        registerReceiver(mReceiver, filter, Context.RECEIVER_NOT_EXPORTED);
+        updateTileState(BypassChargingController.isEnabled(this));
+    }
+
+    @Override
+    public void onStopListening() {
+        try {
+            unregisterReceiver(mReceiver);
+        } catch (IllegalArgumentException ignored) {
+        }
+        super.onStopListening();
+    }
+
+    @Override
+    public void onClick() {
+        super.onClick();
+        boolean currentState = BypassChargingController.isEnabled(this);
+        if (!currentState) {
+            if (!BypassChargingController.isPowerConnected(this)) {
+                Toast.makeText(this, R.string.bypass_charging_connect_charger_toast,
+                        Toast.LENGTH_SHORT).show();
+                updateTileState(false);
+                return;
+            }
+            BypassChargingController.setEnabled(this, true);
+            updateTileState(true);
+        } else {
+            BypassChargingController.setEnabled(this, false);
+            updateTileState(false);
+        }
+    }
+
+    private void updateTileState(boolean active) {
+        Tile tile = getQsTile();
+        if (tile == null) {
+            return;
+        }
+        tile.setState(active ? Tile.STATE_ACTIVE : Tile.STATE_INACTIVE);
+        tile.setSubtitle(getString(active ? R.string.tile_state_on : R.string.tile_state_off));
+        tile.updateTile();
+    }
+}
