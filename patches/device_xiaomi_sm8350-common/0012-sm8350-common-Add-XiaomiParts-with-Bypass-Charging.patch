@@ -0,0 +1,56 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.settings.device;
+
+import android.util.Log;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileReader;
+import java.io.FileWriter;
+import java.io.IOException;
+
+public final class FileUtils {
+    private static final String TAG = "XiaomiParts-FileUtils";
+
+    private FileUtils() {
+    }
+
+    public static boolean fileExists(String path) {
+        if (path == null) {
+            return false;
+        }
+        File file = new File(path);
+        return file.exists();
+    }
+
+    public static String readOneLine(String path) {
+        if (!fileExists(path)) {
+            return null;
+        }
+        try (BufferedReader br = new BufferedReader(new FileReader(path))) {
+            return br.readLine();
+        } catch (IOException e) {
+            Log.e(TAG, "Failed to read from " + path, e);
+            return null;
+        }
+    }
+
+    public static boolean writeLine(String path, String value) {
+        if (!fileExists(path)) {
+            Log.w(TAG, "Target node does not exist: " + path);
+            return false;
+        }
+        try (FileWriter fw = new FileWriter(path)) {
+            fw.write(value);
+            fw.flush();
+            return true;
+        } catch (IOException e) {
+            Log.e(TAG, "Failed to write \"" + value + "\" to " + path, e);
+            return false;
+        }
+    }
+}
