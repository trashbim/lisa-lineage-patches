diff --git a/parts/src/org/lineageos/settings/device/battery/ChargingControlManager.java b/parts/src/org/lineageos/settings/device/battery/ChargingControlManager.java
index fe19460..e96e5cf 100644
--- a/parts/src/org/lineageos/settings/device/battery/ChargingControlManager.java
+++ b/parts/src/org/lineageos/settings/device/battery/ChargingControlManager.java
@@ -22,9 +22,15 @@ public final class ChargingControlManager {
     public static final String PREF_CHARGE_WATT_LIMIT = "pref_charge_watt_limit";
     public static final String PREF_CHARGE_LOGGING_ENABLED = "pref_charge_logging_enabled";
 
+    public static final String NODE_CONSTANT_CHARGE_CURRENT =
+            "/sys/class/power_supply/battery/constant_charge_current";
+    public static final String NODE_CHARGE_CONTROL_LIMIT =
+            "/sys/class/power_supply/battery/charge_control_limit";
     public static final String NODE_RESTRICT_CUR = "/sys/class/qcom-battery/restrict_cur";
     public static final String NODE_RESTRICT_CHG = "/sys/class/qcom-battery/restrict_chg";
 
+    public static final long DEFAULT_MAX_FCC_UA = 5850000L;
+
     private ChargingControlManager() {
     }
 
@@ -80,38 +86,54 @@ public final class ChargingControlManager {
 
     public static int getWattLimit(Context context) {
         SharedPreferences prefs = PreferenceManager.getDefaultSharedPreferences(context);
+        int watts;
         try {
-            return prefs.getInt(PREF_CHARGE_WATT_LIMIT, 33);
+            watts = prefs.getInt(PREF_CHARGE_WATT_LIMIT, 33);
         } catch (Exception e) {
             try {
-                return Integer.parseInt(prefs.getString(PREF_CHARGE_WATT_LIMIT, "33"));
+                watts = Integer.parseInt(prefs.getString(PREF_CHARGE_WATT_LIMIT, "33"));
             } catch (Exception ignored) {
-                return 33;
+                watts = 33;
             }
         }
+        if (watts < 5 || watts > 33) {
+            watts = 33;
+        }
+        return watts;
     }
 
     public static void setWattLimit(Context context, int watts) {
+        if (watts < 5 || watts > 33) {
+            watts = 33;
+        }
         SharedPreferences prefs = PreferenceManager.getDefaultSharedPreferences(context);
         prefs.edit().putInt(PREF_CHARGE_WATT_LIMIT, watts).apply();
         applyWattLimit(watts);
     }
 
     public static void applyWattLimit(int watts) {
-        if (!FileUtils.fileExists(NODE_RESTRICT_CHG)) {
-            return;
-        }
-
-        if (watts >= 33) {
+        if (watts < 5 || watts >= 33) {
             // Unrestricted (Full 33W Mi Turbo Charge)
-            FileUtils.writeLine(NODE_RESTRICT_CHG, "0");
-            Log.d(TAG, "Applied unrestricted charging: 33W");
+            if (FileUtils.fileExists(NODE_CONSTANT_CHARGE_CURRENT)) {
+                FileUtils.writeLine(NODE_CONSTANT_CHARGE_CURRENT, String.valueOf(DEFAULT_MAX_FCC_UA));
+            }
+            if (FileUtils.fileExists(NODE_RESTRICT_CHG)) {
+                FileUtils.writeLine(NODE_RESTRICT_CHG, "0");
+            }
+            Log.d(TAG, "Applied unrestricted charging: 33W (FCC=" + DEFAULT_MAX_FCC_UA + " uA)");
         } else {
             // Convert Watts to microamps based on typical battery voltage ~4.0V
             // I = (P / 4.0V) * 1,000,000 uA
             long targetCurrentUa = (long) ((watts / 4.0) * 1000000);
-            FileUtils.writeLine(NODE_RESTRICT_CUR, String.valueOf(targetCurrentUa));
-            FileUtils.writeLine(NODE_RESTRICT_CHG, "1");
+            if (FileUtils.fileExists(NODE_CONSTANT_CHARGE_CURRENT)) {
+                FileUtils.writeLine(NODE_CONSTANT_CHARGE_CURRENT, String.valueOf(targetCurrentUa));
+            }
+            if (FileUtils.fileExists(NODE_RESTRICT_CUR)) {
+                FileUtils.writeLine(NODE_RESTRICT_CUR, String.valueOf(targetCurrentUa));
+            }
+            if (FileUtils.fileExists(NODE_RESTRICT_CHG)) {
+                FileUtils.writeLine(NODE_RESTRICT_CHG, "1");
+            }
             Log.d(TAG, "Applied watt limit: " + watts + "W (" + (targetCurrentUa / 1000) + " mA)");
         }
