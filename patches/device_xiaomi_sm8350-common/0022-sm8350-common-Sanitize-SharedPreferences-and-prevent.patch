 public class BatterySettingsFragment extends SettingsBasePreferenceFragment
         implements Preference.OnPreferenceChangeListener, Preference.OnPreferenceClickListener {
@@ -57,8 +60,46 @@ public class BatterySettingsFragment extends SettingsBasePreferenceFragment
         }
     };
 
+    private void sanitizePreferences(Context context) {
+        try {
+            SharedPreferences sp = PreferenceManager.getDefaultSharedPreferences(context);
+            SharedPreferences.Editor editor = null;
+            String[] intKeys = new String[] {
+                    ChargingControlManager.PREF_CHARGE_STOP_THRESHOLD,
+                    ChargingControlManager.PREF_CHARGE_START_THRESHOLD,
+                    ChargingControlManager.PREF_CHARGE_WATT_LIMIT
+            };
+            for (String key : intKeys) {
+                if (sp.contains(key)) {
+                    Object val = sp.getAll().get(key);
+                    if (val != null && !(val instanceof Integer)) {
+                        if (editor == null) {
+                            editor = sp.edit();
+                        }
+                        int intVal = 0;
+                        try {
+                            intVal = Integer.parseInt(val.toString());
+                        } catch (Exception ignored) {
+                        }
+                        editor.remove(key);
+                        if (intVal > 0) {
+                            editor.putInt(key, intVal);
+                        }
+                    }
+                }
+            }
+            if (editor != null) {
+                editor.commit();
+            }
+        } catch (Exception ignored) {
+        }
+    }
+
     @Override
     public void onCreatePreferences(Bundle savedInstanceState, String rootKey) {
+        Context context = requireContext();
+        sanitizePreferences(context);
+
         setPreferencesFromResource(R.xml.battery_settings, rootKey);
 
         mLiveDashboardPref = findPreference("pref_live_dashboard");
@@ -70,8 +111,6 @@ public class BatterySettingsFragment extends SettingsBasePreferenceFragment
