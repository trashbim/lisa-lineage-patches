diff --git a/parts/src/org/lineageos/settings/device/battery/BatteryTelemetry.java b/parts/src/org/lineageos/settings/device/battery/BatteryTelemetry.java
new file mode 100644
index 0000000..fdce8a6
--- /dev/null
+++ b/parts/src/org/lineageos/settings/device/battery/BatteryTelemetry.java
@@ -0,0 +1,181 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.settings.device.battery;
+
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.os.BatteryManager;
+
+import org.lineageos.settings.device.FileUtils;
+
+public final class BatteryTelemetry {
+    public static final String NODE_CAPACITY = "/sys/class/power_supply/battery/capacity";
+    public static final String NODE_CURRENT_NOW = "/sys/class/power_supply/battery/current_now";
+    public static final String NODE_VOLTAGE_NOW = "/sys/class/power_supply/battery/voltage_now";
+    public static final String NODE_TEMP = "/sys/class/power_supply/battery/temp";
+    public static final String NODE_CHARGE_COUNTER = "/sys/class/power_supply/battery/charge_counter";
+    public static final String NODE_STATUS = "/sys/class/power_supply/battery/status";
+    public static final String NODE_HEALTH = "/sys/class/power_supply/battery/health";
+
+    public static final String NODE_USB_ONLINE = "/sys/class/power_supply/usb/online";
+    public static final String NODE_USB_VOLTAGE = "/sys/class/power_supply/usb/voltage_now";
+    public static final String NODE_USB_CURRENT_MAX = "/sys/class/power_supply/usb/current_max";
+
+    public static final String NODE_USB_REAL_TYPE = "/sys/class/qcom-battery/usb_real_type";
+    public static final String NODE_PD_VERIFIED = "/sys/class/qcom-battery/pd_verifed";
+    public static final String NODE_FASTCHG_MODE = "/sys/class/qcom-battery/fastchg_mode";
+    public static final String NODE_SOH = "/sys/class/qcom-battery/soh";
+    public static final String NODE_CYCLE = "/sys/class/qcom-battery/fg1_cycle";
+    public static final String NODE_RESISTANCE_ID = "/sys/class/qcom-battery/resistance_id";
+
+    public int capacity;           // % (0-100)
+    public long currentNowUa;      // microamps (< 0 for charging, > 0 for discharging in qcom)
+    public long voltageNowUv;      // microvolts
+    public double powerW;          // calculated power in Watts into/from battery
+    public double tempC;           // temperature in Celsius
+    public long chargeCounterUah;  // accumulated charge in uAh
+    public String status;          // "Charging", "Discharging", "Full", etc.
+    public String health;          // "Good", etc.
+    public boolean isCharging;     // True if battery is gaining energy
+    public boolean isFull;         // True if status is Full
+    public boolean isPlugged;      // True if USB VBUS > 3V or online == 1
+    public long vbusUv;            // VBUS voltage in microvolts
+    public long usbCurrentMaxUa;   // USB port input current limit in microamps
+    public double inputPowerW;     // Power drawn from charger in Watts (Vbus * Ibus)
+    public String protocol;        // SDP, DCP, QC3.0, PD, etc.
+    public boolean turbo33w;       // True if Xiaomi 33W Charge Pump active
+    public int soh;                // State of Health % (e.g. 100)
+    public int cycles;             // Battery charge cycles
+    public long resistanceId;      // Battery resistance ID in ohms
+    public long timestamp;         // System.currentTimeMillis()
+
+    public static BatteryTelemetry readCurrentState(Context context) {
+        BatteryTelemetry t = new BatteryTelemetry();
+        t.timestamp = System.currentTimeMillis();
+
+        // 1. Battery capacity & status from sysfs with BatteryManager fallback
+        t.capacity = readInt(NODE_CAPACITY, -1);
+        t.currentNowUa = readLong(NODE_CURRENT_NOW, 0);
+        t.voltageNowUv = readLong(NODE_VOLTAGE_NOW, 0);
+
+        long rawTemp = readLong(NODE_TEMP, 0);
+        t.tempC = rawTemp > 0 ? rawTemp / 10.0 : 0.0;
+
+        t.chargeCounterUah = readLong(NODE_CHARGE_COUNTER, 0);
+        t.status = readString(NODE_STATUS, "");
+        t.health = readString(NODE_HEALTH, "Good");
+
+        // Intent fallback if sysfs returned empty
+        if (context != null && (t.capacity < 0 || t.voltageNowUv == 0)) {
+            try {
+                Intent batteryIntent = context.registerReceiver(null,
+                        new IntentFilter(Intent.ACTION_BATTERY_CHANGED));
+                if (batteryIntent != null) {
+                    if (t.capacity < 0) {
+                        int level = batteryIntent.getIntExtra(BatteryManager.EXTRA_LEVEL, -1);
+                        int scale = batteryIntent.getIntExtra(BatteryManager.EXTRA_SCALE, -1);
+                        if (level >= 0 && scale > 0) {
+                            t.capacity = (level * 100) / scale;
+                        }
+                    }
+                    if (t.voltageNowUv == 0) {
+                        t.voltageNowUv = batteryIntent.getIntExtra(BatteryManager.EXTRA_VOLTAGE, 0) * 1000L;
+                    }
+                    if (t.tempC == 0.0) {
+                        int temp = batteryIntent.getIntExtra(BatteryManager.EXTRA_TEMPERATURE, 0);
+                        t.tempC = temp / 10.0;
+                    }
+                    if (t.status.isEmpty()) {
+                        int statusInt = batteryIntent.getIntExtra(BatteryManager.EXTRA_STATUS, -1);
+                        if (statusInt == BatteryManager.BATTERY_STATUS_CHARGING) {
+                            t.status = "Charging";
+                        } else if (statusInt == BatteryManager.BATTERY_STATUS_FULL) {
+                            t.status = "Full";
+                        } else {
+                            t.status = "Discharging";
+                        }
+                    }
+                }
+            } catch (Exception ignored) {
+            }
+        }
+
+        if (t.capacity < 0) {
+            t.capacity = 0;
+        }
+        if (t.status.isEmpty()) {
+            t.status = "Discharging";
+        }
+
+        t.isFull = "Full".equalsIgnoreCase(t.status) || t.capacity >= 100;
+
+        // 2. USB and charger input
+        int usbOnline = readInt(NODE_USB_ONLINE, 0);
+        t.vbusUv = readLong(NODE_USB_VOLTAGE, 0);
+        t.usbCurrentMaxUa = readLong(NODE_USB_CURRENT_MAX, 0);
+        t.isPlugged = (usbOnline == 1) || (t.vbusUv >= 3000000);
+
+        // In Qualcomm fuel gauge, negative current indicates charging into battery
+        t.isCharging = (t.currentNowUa < -50000) || "Charging".equalsIgnoreCase(t.status);
+
+        t.protocol = readString(NODE_USB_REAL_TYPE, "USB");
+        int pdVerified = readInt(NODE_PD_VERIFIED, 0);
+        int fastChg = readInt(NODE_FASTCHG_MODE, 0);
+        // On lisa, fastchg_mode returns 33 (for 33W) or 1
+        t.turbo33w = (pdVerified >= 1 && (fastChg == 33 || fastChg == 1));
+
+        t.soh = readInt(NODE_SOH, 100);
+        t.cycles = readInt(NODE_CYCLE, 0);
+        t.resistanceId = readLong(NODE_RESISTANCE_ID, 0);
+
+        // Power calculation in Watts: P = (V * I)
+        double currentA = Math.abs(t.currentNowUa) / 1000000.0;
+        double voltageV = t.voltageNowUv / 1000000.0;
+        t.powerW = Math.round((currentA * voltageV) * 100.0) / 100.0;
+
+        // Input power calculation from charger: Pin = Vbus * Ibus
+        if (t.vbusUv > 0 && t.usbCurrentMaxUa > 0) {
+            double vbusV = t.vbusUv / 1000000.0;
+            double ibusA = t.usbCurrentMaxUa / 1000000.0;
+            t.inputPowerW = Math.round((vbusV * ibusA) * 100.0) / 100.0;
+        } else {
+            t.inputPowerW = 0.0;
+        }
+
+        return t;
+    }
+
+    private static int readInt(String path, int fallback) {
+        String val = FileUtils.readOneLine(path);
+        if (val != null) {
+            try {
+                return Integer.parseInt(val.trim());
+            } catch (NumberFormatException ignored) {
+            }
+        }
+        return fallback;
+    }
+
+    private static long readLong(String path, long fallback) {
+        String val = FileUtils.readOneLine(path);
+        if (val != null) {
+            try {
+                return Long.parseLong(val.trim());
+            } catch (NumberFormatException ignored) {
+            }
+        }
+        return fallback;
+    }
+
+    private static String readString(String path, String fallback) {
+        String val = FileUtils.readOneLine(path);
+        if (val != null && !val.trim().isEmpty()) {
+            return val.trim();
+        }
+        return fallback;
+    }
+}
