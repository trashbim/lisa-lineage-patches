Date: Fri, 16 Oct 2026 21:47:45 +0300
Subject: [PATCH 27/27] parts: battery: Remove problematic
 restrict_chg/cool_mode calls and 1s poll spam

Change-Id: I40a55b86c4b50e6e4629a58c4545ed3fa4098f64
---
 .../device/battery/BatteryMonitorService.java | 10 +---
 .../battery/ChargingControlManager.java       | 54 ++++---------------
 2 files changed, 12 insertions(+), 52 deletions(-)

diff --git a/parts/src/org/lineageos/settings/device/battery/BatteryMonitorService.java b/parts/src/org/lineageos/settings/device/battery/BatteryMonitorService.java
index b47cddc..3e29bf2 100644
--- a/parts/src/org/lineageos/settings/device/battery/BatteryMonitorService.java
+++ b/parts/src/org/lineageos/settings/device/battery/BatteryMonitorService.java
@@ -42,15 +42,7 @@ public class BatteryMonitorService extends Service {
                 // 1. Apply charge threshold hysteresis
                 ChargingControlManager.applyHysteresis(BatteryMonitorService.this, t);
 
-                // 2. Re-enforce watt limit if actively charging
-                if (t.isCharging) {
-                    int watts = ChargingControlManager.getWattLimit(BatteryMonitorService.this);
-                    if (watts < 33) {
-                        ChargingControlManager.applyWattLimit(watts);
-                    }
-                }
-
-                // 3. Log sample if enabled
+                // 2. Log sample if enabled
                 if (ChargingControlManager.isLoggingEnabled(BatteryMonitorService.this)) {
                     BatteryTelemetryLogger.logSample(t);
                 }
diff --git a/parts/src/org/lineageos/settings/device/battery/ChargingControlManager.java b/parts/src/org/lineageos/settings/device/battery/ChargingControlManager.java
index 9026f3d..b9cdc8a 100644
--- a/parts/src/org/lineageos/settings/device/battery/ChargingControlManager.java
+++ b/parts/src/org/lineageos/settings/device/battery/ChargingControlManager.java
@@ -124,12 +124,6 @@ public final class ChargingControlManager {
                 if (FileUtils.fileExists(NODE_CHARGE_CONTROL_LIMIT)) {
                     FileUtils.writeLine(NODE_CHARGE_CONTROL_LIMIT, "0");
                 }
-                if (FileUtils.fileExists(NODE_COOL_MODE)) {
-                    FileUtils.writeLine(NODE_COOL_MODE, "0");
-                }
-                if (FileUtils.fileExists(NODE_RESTRICT_CHG)) {
-                    FileUtils.writeLine(NODE_RESTRICT_CHG, "0");
-                }
                 Log.d(TAG, "Applied unrestricted charging: 33W");
             } else {
                 // Convert Watts to microamps based on typical battery voltage ~4.0V
@@ -139,58 +133,32 @@ public final class ChargingControlManager {
                     FileUtils.writeLine(NODE_CONSTANT_CHARGE_CURRENT, String.valueOf(targetCurrentUa));
                 }
 
-                // Map requested watts to thermal mitigation level (0-20)
-                // Level 20 = 0.5A (~2.1W)
-                // Level 19 = 1.0A (~4.2W)
-                // Level 18 = 1.5A (~6.3W)
-                // Level 17 = 2.0A (~8.4W)
-                // Level 16 = 2.5A (~10.5W)
-                // Level 15 = 3.0A (~12.6W)
-                // Level 14 = 3.5A (~14.7W)
-                // Level 13 = 4.0A (~16.8W)
-                // Level 12 = 4.5A (~18.9W)
-                // Level 11 = 5.0A (~21.0W)
+                // Map requested watts to safe thermal mitigation levels (0-15)
                 int thermalLevel;
-                if (watts <= 2) {
-                    thermalLevel = 20;
-                } else if (watts <= 4) {
-                    thermalLevel = 19;
-                } else if (watts <= 6) {
-                    thermalLevel = 18;
-                } else if (watts <= 8) {
-                    thermalLevel = 17;
-                } else if (watts <= 10) {
-                    thermalLevel = 16;
+                if (watts <= 10) {
+                    thermalLevel = 15; // 2.5A cap
                 } else if (watts <= 12) {
-                    thermalLevel = 15;
-                } else if (watts <= 14) {
                     thermalLevel = 14;
-                } else if (watts <= 16) {
+                } else if (watts <= 14) {
                     thermalLevel = 13;
-                } else if (watts <= 18) {
+                } else if (watts <= 16) {
                     thermalLevel = 12;
-                } else if (watts <= 20) {
+                } else if (watts <= 18) {
                     thermalLevel = 11;
+                } else if (watts <= 20) {
+                    thermalLevel = 10;
                 } else if (watts <= 24) {
-                    thermalLevel = 9;
+                    thermalLevel = 8;
                 } else if (watts <= 28) {
-                    thermalLevel = 7;
+                    thermalLevel = 6;
                 } else {
-                    thermalLevel = 5;
+                    thermalLevel = 4;
                 }
 
                 if (FileUtils.fileExists(NODE_CHARGE_CONTROL_LIMIT)) {
                     FileUtils.writeLine(NODE_CHARGE_CONTROL_LIMIT, String.valueOf(thermalLevel));
                 }
 
-                if (FileUtils.fileExists(NODE_COOL_MODE)) {
-                    FileUtils.writeLine(NODE_COOL_MODE, "1");
-                }
-
-                if (FileUtils.fileExists(NODE_RESTRICT_CHG)) {
-                    FileUtils.writeLine(NODE_RESTRICT_CHG, "1");
-                }
-
                 Log.d(TAG, "Applied watt limit: " + watts + "W (" + (targetCurrentUa / 1000)
                         + " mA, ccl=" + thermalLevel + ")");
             }
