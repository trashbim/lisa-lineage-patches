-
-package org.lineageos.settings.device.hbm;
-
-import android.app.Service;
-import android.content.BroadcastReceiver;
-import android.content.Context;
-import android.content.Intent;
-import android.content.IntentFilter;
-import android.os.IBinder;
-import android.util.Log;
-
-public class HbmMonitorService extends Service {
-    private static final String TAG = "HbmMonitorService";
-
-    private final BroadcastReceiver mScreenStateReceiver = new BroadcastReceiver() {
-        @Override
-        public void onReceive(Context context, Intent intent) {
-            if (Intent.ACTION_SCREEN_OFF.equals(intent.getAction())) {
-                Log.d(TAG, "Screen off detected, auto-disabling HBM for panel safety");
-                HbmController.setEnabled(context, false);
-                stopSelf();
-            }
-        }
-    };
-
-    @Override
-    public void onCreate() {
-        super.onCreate();
-        IntentFilter filter = new IntentFilter();
-        filter.addAction(Intent.ACTION_SCREEN_OFF);
-        registerReceiver(mScreenStateReceiver, filter);
-        Log.d(TAG, "HbmMonitorService started");
-    }
-
-    @Override
-    public int onStartCommand(Intent intent, int flags, int startId) {
-        return START_STICKY;
-    }
-
-    @Override
-    public void onDestroy() {
-        try {
-            unregisterReceiver(mScreenStateReceiver);
-        } catch (IllegalArgumentException ignored) {
-        }
-        Log.d(TAG, "HbmMonitorService stopped");
-        super.onDestroy();
-    }
-
-    @Override
-    public IBinder onBind(Intent intent) {
-        return null;
-    }
-}
