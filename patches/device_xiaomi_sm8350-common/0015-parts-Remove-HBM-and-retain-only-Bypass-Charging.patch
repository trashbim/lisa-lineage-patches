diff --git a/parts/src/org/lineageos/settings/device/hbm/HbmController.java b/parts/src/org/lineageos/settings/device/hbm/HbmController.java
deleted file mode 100644
index e7af964..0000000
--- a/parts/src/org/lineageos/settings/device/hbm/HbmController.java
+++ /dev/null
@@ -1,104 +0,0 @@
-/*
- * SPDX-FileCopyrightText: The LineageOS Project
- * SPDX-License-Identifier: Apache-2.0
- */
-
-package org.lineageos.settings.device.hbm;
-
-import android.content.ContentResolver;
-import android.content.Context;
-import android.content.Intent;
-import android.content.SharedPreferences;
-import android.provider.Settings;
-import android.util.Log;
-
-import androidx.preference.PreferenceManager;
-
-import org.lineageos.settings.device.FileUtils;
-
-public final class HbmController {
-    public static final String TAG = "HbmController";
-    public static final String NODE_BACKLIGHT = "/sys/class/backlight/panel0-backlight/brightness";
-    public static final String PREF_HBM = "pref_hbm";
-    public static final String PREF_SAVED_BRIGHTNESS = "pref_saved_brightness";
-    public static final String PREF_SAVED_BRIGHTNESS_MODE = "pref_saved_brightness_mode";
-    public static final String ACTION_HBM_CHANGED = "org.lineageos.settings.device.ACTION_HBM_CHANGED";
-    public static final String EXTRA_HBM_STATE = "extra_hbm_state";
-
-    private HbmController() {
-    }
-
-    public static boolean isSupported() {
-        return true;
-    }
-
-    public static boolean isEnabled(Context context) {
-        SharedPreferences prefs = PreferenceManager.getDefaultSharedPreferences(context);
-        return prefs.getBoolean(PREF_HBM, false);
-    }
-
-    public static void setEnabled(Context context, boolean enable) {
-        SharedPreferences prefs = PreferenceManager.getDefaultSharedPreferences(context);
-        boolean current = prefs.getBoolean(PREF_HBM, false);
-        if (current == enable) {
-            return;
-        }
-
-        ContentResolver resolver = context.getContentResolver();
-
-        if (enable) {
-            int currentBrightness = Settings.System.getInt(resolver, Settings.System.SCREEN_BRIGHTNESS, 128);
-            int currentMode = Settings.System.getInt(resolver, Settings.System.SCREEN_BRIGHTNESS_MODE,
-                    Settings.System.SCREEN_BRIGHTNESS_MODE_MANUAL);
-
-            prefs.edit()
-                    .putBoolean(PREF_HBM, true)
-                    .putInt(PREF_SAVED_BRIGHTNESS, currentBrightness)
-                    .putInt(PREF_SAVED_BRIGHTNESS_MODE, currentMode)
-                    .apply();
-
-            try {
-                Settings.System.putInt(resolver, Settings.System.SCREEN_BRIGHTNESS_MODE,
-                        Settings.System.SCREEN_BRIGHTNESS_MODE_MANUAL);
-                Settings.System.putInt(resolver, Settings.System.SCREEN_BRIGHTNESS, 255);
-            } catch (Exception e) {
-                Log.e(TAG, "Failed to set system brightness", e);
-            }
-
-            // Write max 4095 (1000 nits hardware command 51 0F FF)
-            FileUtils.writeLine(NODE_BACKLIGHT, "4095");
-
-            try {
-                Intent serviceIntent = new Intent(context, HbmMonitorService.class);
-                context.startService(serviceIntent);
-            } catch (Exception e) {
-                Log.e(TAG, "Failed to start HbmMonitorService", e);
-            }
-        } else {
-            int savedBrightness = prefs.getInt(PREF_SAVED_BRIGHTNESS, 128);
-            int savedMode = prefs.getInt(PREF_SAVED_BRIGHTNESS_MODE, Settings.System.SCREEN_BRIGHTNESS_MODE_MANUAL);
-
-            prefs.edit().putBoolean(PREF_HBM, false).apply();
-
-            try {
-                Settings.System.putInt(resolver, Settings.System.SCREEN_BRIGHTNESS, savedBrightness);
-                Settings.System.putInt(resolver, Settings.System.SCREEN_BRIGHTNESS_MODE, savedMode);
-            } catch (Exception e) {
-                Log.e(TAG, "Failed to restore system brightness", e);
-            }
-
-            try {
-                Intent serviceIntent = new Intent(context, HbmMonitorService.class);
-                context.stopService(serviceIntent);
-            } catch (Exception e) {
-                Log.e(TAG, "Failed to stop HbmMonitorService", e);
-            }
-        }
-
-        Intent broadcast = new Intent(ACTION_HBM_CHANGED);
-        broadcast.putExtra(EXTRA_HBM_STATE, enable);
-        broadcast.setPackage(context.getPackageName());
-        context.sendBroadcast(broadcast);
-        Log.d(TAG, "HBM state set to " + enable);
-    }
-}
