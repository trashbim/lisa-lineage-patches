From 4e4bec8b17c0403675f8be3298e06b6f721ba3aa Mon Sep 17 00:00:00 2001
From: Valera <valera@example.com>
Date: Mon, 21 Sep 2026 14:48:36 +0300
Subject: [PATCH 10/10] sm8350-common: Optimize VM, I/O, schedutil down-rate
 limits, and Wi-Fi logging

- Set vm.stat_interval to 10s to reduce idle CPU timer wakeups
- Set UFS I/O scheduler to 'none' for direct hardware multi-queue dispatch
- Set UFS read_ahead_kb to 128 KB to minimize read amplification
- Set schedutil down_rate_limit_us (20ms silver, 10ms gold/prime) to smooth frame pacing and reduce DVFS jitter
- Disable ART dex2oat mini-debug-info to save storage and memory footprint
- Disable Wi-Fi firmware logging in WCNSS_qcom_cfg.ini to eliminate DMA polling overhead

Change-Id: I0ba6af769631ac6c621f181da675ee9184c0d3ef
---
 rootdir/bin/init.kernel.post_boot-yupik.sh | 35 ++++++++--------------
 rootdir/etc/init.qti.kernel.rc             | 24 ++++++---------
 vendor.prop                                |  5 ++++
 wifi/WCNSS_qcom_cfg.ini                    |  2 +-
 4 files changed, 28 insertions(+), 38 deletions(-)

diff --git a/rootdir/bin/init.kernel.post_boot-yupik.sh b/rootdir/bin/init.kernel.post_boot-yupik.sh
index 7801dd6..a4f8e49 100755
--- a/rootdir/bin/init.kernel.post_boot-yupik.sh
+++ b/rootdir/bin/init.kernel.post_boot-yupik.sh
@@ -71,26 +71,16 @@ function configure_zram_parameters() {
 }
 
 function configure_read_ahead_kb_values() {
-	MemTotalStr=`cat /proc/meminfo | grep MemTotal`
-	MemTotal=${MemTotalStr:16:8}
+	# Set 128 KB for optimal UFS random I/O and low read amplification
+	ra_kb=128
 
-	dmpts=$(ls /sys/block/*/queue/read_ahead_kb | grep -e dm -e mmc)
-
-	# Set 128 for <= 3GB &
-	# set 512 for >= 4GB targets.
-	if [ $MemTotal -le 3145728 ]; then
-		ra_kb=128
-	else
-		ra_kb=512
-	fi
-	if [ -f /sys/block/mmcblk0/bdi/read_ahead_kb ]; then
-		echo $ra_kb > /sys/block/mmcblk0/bdi/read_ahead_kb
-	fi
-	if [ -f /sys/block/mmcblk0rpmb/bdi/read_ahead_kb ]; then
-		echo $ra_kb > /sys/block/mmcblk0rpmb/bdi/read_ahead_kb
-	fi
-	for dm in $dmpts; do
-		echo $ra_kb > $dm
+	for dev in /sys/block/sd* /sys/block/dm* /sys/block/mmc*; do
+		if [ -f "$dev/queue/read_ahead_kb" ]; then
+			echo $ra_kb > "$dev/queue/read_ahead_kb"
+		fi
+		if [ -f "$dev/bdi/read_ahead_kb" ]; then
+			echo $ra_kb > "$dev/bdi/read_ahead_kb"
+		fi
 	done
 }
 
@@ -119,6 +109,7 @@ function configure_memory_parameters() {
 	configure_zram_parameters
 	configure_read_ahead_kb_values
 	echo 100 > /proc/sys/vm/swappiness
+	echo 10 > /proc/sys/vm/stat_interval
 
         # Disable wsf  beacause we are using efk.
         # wsf Range : 1..1000. So set to bare minimum value 1.
@@ -184,7 +175,7 @@ echo 0-3 > /dev/cpuset/system-background/cpus
 
 # configure governor settings for silver cluster
 echo "schedutil" > /sys/devices/system/cpu/cpufreq/policy0/scaling_governor
-echo 0 > /sys/devices/system/cpu/cpufreq/policy0/schedutil/down_rate_limit_us
+echo 20000 > /sys/devices/system/cpu/cpufreq/policy0/schedutil/down_rate_limit_us
 echo 0 > /sys/devices/system/cpu/cpufreq/policy0/schedutil/up_rate_limit_us
 echo 1152000 > /sys/devices/system/cpu/cpufreq/policy0/schedutil/hispeed_freq
 echo 691200 > /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
@@ -196,7 +187,7 @@ echo 120 > /sys/devices/system/cpu/cpu_boost/input_boost_ms
 
 # configure governor settings for gold cluster
 echo "schedutil" > /sys/devices/system/cpu/cpufreq/policy4/scaling_governor
-echo 0 > /sys/devices/system/cpu/cpufreq/policy4/schedutil/down_rate_limit_us
+echo 10000 > /sys/devices/system/cpu/cpufreq/policy4/schedutil/down_rate_limit_us
 echo 0 > /sys/devices/system/cpu/cpufreq/policy4/schedutil/up_rate_limit_us
 echo 1228800 > /sys/devices/system/cpu/cpufreq/policy4/schedutil/hispeed_freq
 echo 691200 > /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq
@@ -209,7 +200,7 @@ echo 0 > /sys/devices/system/cpu/cpufreq/policy4/schedutil/pl
 
 # configure governor settings for gold+ cluster
 echo "schedutil" > /sys/devices/system/cpu/cpufreq/policy7/scaling_governor
-echo 0 > /sys/devices/system/cpu/cpufreq/policy7/schedutil/down_rate_limit_us
+echo 10000 > /sys/devices/system/cpu/cpufreq/policy7/schedutil/down_rate_limit_us
 echo 0 > /sys/devices/system/cpu/cpufreq/policy7/schedutil/up_rate_limit_us
 echo 1324800 > /sys/devices/system/cpu/cpufreq/policy7/schedutil/hispeed_freq
 echo 806400 > /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq
diff --git a/rootdir/etc/init.qti.kernel.rc b/rootdir/etc/init.qti.kernel.rc
index aabe550..dd549f3 100644
--- a/rootdir/etc/init.qti.kernel.rc
+++ b/rootdir/etc/init.qti.kernel.rc
@@ -49,21 +49,13 @@ on early-boot
     write /sys/devices/virtual/cvp/cvp/boot 1
 
 on boot
-    # Set the io-scheduler to bfq on all mq support devices
-    write /sys/block/sda/queue/scheduler bfq
-    write /sys/block/sdb/queue/scheduler bfq
-    write /sys/block/sdc/queue/scheduler bfq
-    write /sys/block/sdd/queue/scheduler bfq
-    write /sys/block/sde/queue/scheduler bfq
-    write /sys/block/sdf/queue/scheduler bfq
-
-    # Update io-scheduler tunables
-    write /sys/block/sda/queue/iosched/slice_idle 0
-    write /sys/block/sdb/queue/iosched/slice_idle 0
-    write /sys/block/sdc/queue/iosched/slice_idle 0
-    write /sys/block/sdd/queue/iosched/slice_idle 0
-    write /sys/block/sde/queue/iosched/slice_idle 0
-    write /sys/block/sdf/queue/iosched/slice_idle 0
+    # Set the io-scheduler to none on all mq support devices
+    write /sys/block/sda/queue/scheduler none
+    write /sys/block/sdb/queue/scheduler none
+    write /sys/block/sdc/queue/scheduler none
+    write /sys/block/sdd/queue/scheduler none
+    write /sys/block/sde/queue/scheduler none
+    write /sys/block/sdf/queue/scheduler none
 
 service kernel-post-boot /vendor/bin/sh /vendor/bin/init.kernel.post_boot.sh
     class core
@@ -74,9 +66,11 @@ service kernel-post-boot /vendor/bin/sh /vendor/bin/init.kernel.post_boot.sh
 
 on property:sys.boot_completed=1
     write /proc/sys/vm/page-cluster 0
+    write /proc/sys/vm/stat_interval 10
 
     start kernel-post-boot
 
+
 service vendor.msm_irqbalance /vendor/bin/msm_irqbalance -f /system/vendor/etc/msm_irqbalance.conf
     class core
     user root
diff --git a/vendor.prop b/vendor.prop
index 248d46f..4206616 100644
--- a/vendor.prop
+++ b/vendor.prop
@@ -298,3 +298,8 @@ persist.sys.ssr.enable_ramdumps=0
 persist.vendor.sys.modem.logging.enable=false
 persist.vendor.radio.snapshot_enabled=0
 
+# Disable embedding mini-debug-info in compiled dex/oat binaries
+dalvik.vm.minidebuginfo=false
+dalvik.vm.dex2oat-minidebuginfo=false
+
+
diff --git a/wifi/WCNSS_qcom_cfg.ini b/wifi/WCNSS_qcom_cfg.ini
index d7122be..de589d5 100644
--- a/wifi/WCNSS_qcom_cfg.ini
+++ b/wifi/WCNSS_qcom_cfg.ini
@@ -32,7 +32,7 @@ gEnableTxBFin20MHz=1
 gEnableTxSUBeamformer=1
 gRrmEnable=1
 gEnablefwprint=0
-gEnablefwlog=1
+gEnablefwlog=0
 gVhtAmpduLenExponent=7
 gVhtMpduLen=2
 isP2pDeviceAddrAdministrated=0
