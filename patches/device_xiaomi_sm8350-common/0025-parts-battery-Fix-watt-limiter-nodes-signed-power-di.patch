diff --git a/parts/src/org/lineageos/settings/device/battery/BatterySettingsFragment.java b/parts/src/org/lineageos/settings/device/battery/BatterySettingsFragment.java
index f04de2b..0ef096f 100644
--- a/parts/src/org/lineageos/settings/device/battery/BatterySettingsFragment.java
+++ b/parts/src/org/lineageos/settings/device/battery/BatterySettingsFragment.java
@@ -178,11 +178,7 @@ public class BatterySettingsFragment extends SettingsBasePreferenceFragment
             mWattLimitPref.setSummary("Без ограничений (33 Вт Турбо 🚀)");
         } else {
             long targetCurrentMa = (long) ((watts / 4.0) * 1000);
-            if (watts <= 3) {
-                mWattLimitPref.setSummary(String.format(Locale.US, "%d Вт (~%d мА, Ночной тихий режим 🌙)", watts, targetCurrentMa));
-            } else {
-                mWattLimitPref.setSummary(String.format(Locale.US, "%d Вт (~%d мА)", watts, targetCurrentMa));
-            }
+            mWattLimitPref.setSummary(String.format(Locale.US, "%d Вт (~%d мА)", watts, targetCurrentMa));
         }
     }
 
@@ -224,16 +220,26 @@ public class BatterySettingsFragment extends SettingsBasePreferenceFragment
                 mTelemetryPowerPref.setSummary(String.format(Locale.US,
                         "Питание в обход батареи • Аккумулятор: %d%% (%.3f В, отдых)",
                         t.capacity, voltageV));
-            } else if (t.isCharging) {
-                mTelemetryPowerPref.setTitle(String.format(Locale.US, "⚡ Зарядка: %.2f Вт", t.powerW));
+            } else if (t.currentNowUa < -50000) {
+                mTelemetryPowerPref.setTitle(String.format(Locale.US, "⚡ Зарядка: +%.2f Вт", t.powerW));
                 mTelemetryPowerPref.setSummary(String.format(Locale.US,
                         "Ток: +%.0f мА • Напряжение батареи: %.3f В",
                         currentMa, voltageV));
+            } else if (t.currentNowUa > 50000) {
+                mTelemetryPowerPref.setTitle(String.format(Locale.US, "🔋 Разряд: -%.2f Вт", t.powerW));
+                if (t.isPlugged) {
+                    mTelemetryPowerPref.setSummary(String.format(Locale.US,
