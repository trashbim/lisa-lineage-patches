diff --git a/parts/src/org/lineageos/settings/device/battery/BatteryTelemetry.java b/parts/src/org/lineageos/settings/device/battery/BatteryTelemetry.java
index def65ac..eefb161 100644
--- a/parts/src/org/lineageos/settings/device/battery/BatteryTelemetry.java
+++ b/parts/src/org/lineageos/settings/device/battery/BatteryTelemetry.java
@@ -69,8 +69,8 @@ public final class BatteryTelemetry {
         t.usbCurrentMaxUa = readLong(NODE_USB_CURRENT_MAX, 0);
         t.isPlugged = (usbOnline == 1) || (t.vbusUv >= 3000000);
 
-        // In Qualcomm fuel gauge, negative current indicates charging
-        t.isCharging = (t.currentNowUa < 0) || "Charging".equalsIgnoreCase(t.status);
+        // In Qualcomm fuel gauge, negative current indicates charging into battery
+        t.isCharging = t.currentNowUa < -50000;
 
         t.protocol = readString(NODE_USB_REAL_TYPE, "Unknown");
         int pdVerified = readInt(NODE_PD_VERIFIED, 0);
diff --git a/parts/src/org/lineageos/settings/device/battery/ChargingControlManager.java b/parts/src/org/lineageos/settings/device/battery/ChargingControlManager.java
index 70053a1..6520628 100644
--- a/parts/src/org/lineageos/settings/device/battery/ChargingControlManager.java
+++ b/parts/src/org/lineageos/settings/device/battery/ChargingControlManager.java
@@ -111,30 +111,77 @@ public final class ChargingControlManager {
         applyWattLimit(watts);
     }
 
+    public static final String NODE_COOL_MODE =
+            "/sys/class/qcom-battery/cool_mode";
+
     public static void applyWattLimit(int watts) {
-        if (watts < 1 || watts >= 33) {
-            // Unrestricted (Full 33W Mi Turbo Charge)
-            if (FileUtils.fileExists(NODE_CONSTANT_CHARGE_CURRENT)) {
-                FileUtils.writeLine(NODE_CONSTANT_CHARGE_CURRENT, String.valueOf(DEFAULT_MAX_FCC_UA));
+        try {
+            if (watts < 1 || watts >= 33) {
+                // Unrestricted (Full 33W Mi Turbo Charge)
+                if (FileUtils.fileExists(NODE_CONSTANT_CHARGE_CURRENT)) {
+                    FileUtils.writeLine(NODE_CONSTANT_CHARGE_CURRENT, String.valueOf(DEFAULT_MAX_FCC_UA));
+                }
+                if (FileUtils.fileExists(NODE_CHARGE_CONTROL_LIMIT)) {
+                    FileUtils.writeLine(NODE_CHARGE_CONTROL_LIMIT, "0");
+                }
+                if (FileUtils.fileExists(NODE_COOL_MODE)) {
+                    FileUtils.writeLine(NODE_COOL_MODE, "0");
+                }
+                if (FileUtils.fileExists(NODE_RESTRICT_CHG)) {
+                    FileUtils.writeLine(NODE_RESTRICT_CHG, "0");
+                }
+                Log.d(TAG, "Applied unrestricted charging: 33W");
+            } else {
+                // Convert Watts to microamps based on typical battery voltage ~4.0V
+                // I = (P / 4.0V) * 1,000,000 uA
+                long targetCurrentUa = (long) ((watts / 4.0) * 1000000);
+                if (FileUtils.fileExists(NODE_CONSTANT_CHARGE_CURRENT)) {
+                    FileUtils.writeLine(NODE_CONSTANT_CHARGE_CURRENT, String.valueOf(targetCurrentUa));
+                }
+
+                // Map requested watts to thermal mitigation level (0-15)
+                // Level 15 = 2.5A (cap ~10W)
+                // Level 13 = 3.5A (~14W)
+                // Level 10 = 5.0A (~20W)
+                // Level 6  = 7.0A (~28W)
+                int thermalLevel;
+                if (watts <= 10) {
+                    thermalLevel = 15;
+                } else if (watts <= 12) {
+                    thermalLevel = 14;
+                } else if (watts <= 14) {
+                    thermalLevel = 13;
+                } else if (watts <= 16) {
+                    thermalLevel = 12;
+                } else if (watts <= 18) {
+                    thermalLevel = 11;
+                } else if (watts <= 20) {
+                    thermalLevel = 10;
+                } else if (watts <= 24) {
+                    thermalLevel = 8;
+                } else if (watts <= 28) {
+                    thermalLevel = 6;
+                } else {
+                    thermalLevel = 4;
+                }
+
+                if (FileUtils.fileExists(NODE_CHARGE_CONTROL_LIMIT)) {
+                    FileUtils.writeLine(NODE_CHARGE_CONTROL_LIMIT, String.valueOf(thermalLevel));
+                }
+
+                if (FileUtils.fileExists(NODE_COOL_MODE)) {
+                    FileUtils.writeLine(NODE_COOL_MODE, "1");
+                }
+
+                if (FileUtils.fileExists(NODE_RESTRICT_CHG)) {
+                    FileUtils.writeLine(NODE_RESTRICT_CHG, "1");
+                }
+
+                Log.d(TAG, "Applied watt limit: " + watts + "W (" + (targetCurrentUa / 1000)
+                        + " mA, ccl=" + thermalLevel + ")");
             }
-            if (FileUtils.fileExists(NODE_RESTRICT_CHG)) {
-                FileUtils.writeLine(NODE_RESTRICT_CHG, "0");
-            }
-            Log.d(TAG, "Applied unrestricted charging: 33W (FCC=" + DEFAULT_MAX_FCC_UA + " uA)");
-        } else {
-            // Convert Watts to microamps based on typical battery voltage ~4.0V
-            // I = (P / 4.0V) * 1,000,000 uA
-            long targetCurrentUa = (long) ((watts / 4.0) * 1000000);
-            if (FileUtils.fileExists(NODE_CONSTANT_CHARGE_CURRENT)) {
-                FileUtils.writeLine(NODE_CONSTANT_CHARGE_CURRENT, String.valueOf(targetCurrentUa));
-            }
-            if (FileUtils.fileExists(NODE_RESTRICT_CUR)) {
-                FileUtils.writeLine(NODE_RESTRICT_CUR, String.valueOf(targetCurrentUa));
-            }
-            if (FileUtils.fileExists(NODE_RESTRICT_CHG)) {
-                FileUtils.writeLine(NODE_RESTRICT_CHG, "1");
-            }
-            Log.d(TAG, "Applied watt limit: " + watts + "W (" + (targetCurrentUa / 1000) + " mA)");
+        } catch (Exception e) {
+            Log.e(TAG, "Error applying watt limit: " + e.getMessage());
         }
     }
 
diff --git a/rootdir/etc/init.batterysecret.rc b/rootdir/etc/init.batterysecret.rc
index 4691158..8e3b8c2 100644
--- a/rootdir/etc/init.batterysecret.rc
+++ b/rootdir/etc/init.batterysecret.rc
@@ -16,6 +16,8 @@ on property:sys.boot_completed=1
     chmod 0664 /sys/class/power_supply/battery/charge_control_limit
     chown system system /sys/class/power_supply/usb/voltage_now
     chmod 0664 /sys/class/power_supply/usb/voltage_now
+    chown system system /sys/class/qcom-battery/cool_mode
+    chmod 0664 /sys/class/qcom-battery/cool_mode
 
 service batterysecret /vendor/bin/batterysecret
     class last_start
