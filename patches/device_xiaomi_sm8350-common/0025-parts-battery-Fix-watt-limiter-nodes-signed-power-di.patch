+                } else {
+                    mTelemetryPowerPref.setSummary(String.format(Locale.US,
+                            "Расход: -%.0f мА • Напряжение батареи: %.3f В",
+                            currentMa, voltageV));
+                }
             } else {
-                mTelemetryPowerPref.setTitle(String.format(Locale.US, "🔋 Разряд: %.2f Вт", t.powerW));
+                mTelemetryPowerPref.setTitle("⚡ Баланс: 0.00 Вт");
                 mTelemetryPowerPref.setSummary(String.format(Locale.US,
-                        "Расход: -%.0f мА • Напряжение батареи: %.3f В",
-                        currentMa, voltageV));
+                        "Ток: ~0 мА • Напряжение батареи: %.3f В", voltageV));
             }
