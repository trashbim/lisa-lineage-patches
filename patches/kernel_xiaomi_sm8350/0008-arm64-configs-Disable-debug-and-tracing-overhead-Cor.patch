From b327af25080c0446f804cd9c7d1acec8ca21f9cc Mon Sep 17 00:00:00 2001
From: Valera <valera@example.com>
Date: Mon, 21 Sep 2026 14:39:13 +0300
Subject: [PATCH 8/9] arm64: configs: Disable debug and tracing overhead
 (CoreSight, schedstats, stack usage, EDL)

- CONFIG_CORESIGHT: frees RAM and removes hardware bus tracing overhead
- CONFIG_SCHEDSTATS: eliminates scheduler accounting hooks on context switches
- CONFIG_DEBUG_STACK_USAGE: eliminates stack watermarking checks
- CONFIG_QCOM_KGSL_CONTEXT_DEBUG: removes Adreno KGSL context dumping overhead
- CONFIG_POWER_RESET_QCOM_DOWNLOAD_MODE_DEFAULT: reboots cleanly instead of hanging in EDL mode on kernel panic

Change-Id: I6a3390f7ffdbe3eb4e34299305875091b8c93cbe
---
 arch/arm64/configs/vendor/xiaomi_QGKI.config | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/configs/vendor/xiaomi_QGKI.config b/arch/arm64/configs/vendor/xiaomi_QGKI.config
index 867fad96c476..e29ae3ff41fd 100644
--- a/arch/arm64/configs/vendor/xiaomi_QGKI.config
+++ b/arch/arm64/configs/vendor/xiaomi_QGKI.config
@@ -49,5 +49,10 @@ CONFIG_DEFAULT_BBR=y
 CONFIG_NET_SCH_FQ=y
 
 
-# Disable page owner debug overhead
+# Disable debugging and tracing overhead
 # CONFIG_PAGE_OWNER is not set
+# CONFIG_CORESIGHT is not set
+# CONFIG_SCHEDSTATS is not set
+# CONFIG_DEBUG_STACK_USAGE is not set
+# CONFIG_QCOM_KGSL_CONTEXT_DEBUG is not set
+# CONFIG_POWER_RESET_QCOM_DOWNLOAD_MODE_DEFAULT is not set
