From 0c9337fcedaf3d3f2586852e86411685ce596e0e Mon Sep 17 00:00:00 2001
From: Valera <valera@example.com>
Date: Mon, 21 Sep 2026 14:48:33 +0300
Subject: [PATCH 9/9] arm64: configs: Disable CONFIG_KALLSYMS_ALL to free
 kernel memory

Keeps CONFIG_KALLSYMS for function symbols and oops backtraces while
omitting data/variable symbols, saving ~2 MB of wired kernel RAM.

Change-Id: I372de1d489bc4f3ab30a81b646595cb3afd72793
---
 arch/arm64/configs/vendor/xiaomi_QGKI.config | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/configs/vendor/xiaomi_QGKI.config b/arch/arm64/configs/vendor/xiaomi_QGKI.config
index e29ae3ff41fd..4ee30cd2882a 100644
--- a/arch/arm64/configs/vendor/xiaomi_QGKI.config
+++ b/arch/arm64/configs/vendor/xiaomi_QGKI.config
@@ -56,3 +56,5 @@ CONFIG_NET_SCH_FQ=y
 # CONFIG_DEBUG_STACK_USAGE is not set
 # CONFIG_QCOM_KGSL_CONTEXT_DEBUG is not set
 # CONFIG_POWER_RESET_QCOM_DOWNLOAD_MODE_DEFAULT is not set
+# CONFIG_KALLSYMS_ALL is not set
+
