From 1c5c33aa2a993fc685df93b0a41d7fe76a0224eb Mon Sep 17 00:00:00 2001
From: Valera <valera@example.com>
Date: Fri, 18 Sep 2026 19:52:01 +0300
Subject: [PATCH 2/8] arm64: configs: Enable TCP BBR congestion control as
 default

Enable BBR (Bottleneck Bandwidth and RTT) algorithm developed by Google
along with Fair Queue (FQ) packet scheduler for higher throughput and
reduced latency over cellular and Wi-Fi networks.

Change-Id: I22bc192666d421ff7117ab4c4134249b01737179
---
 arch/arm64/configs/vendor/xiaomi_QGKI.config | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm64/configs/vendor/xiaomi_QGKI.config b/arch/arm64/configs/vendor/xiaomi_QGKI.config
index 99069f04518f..48e1d1db4a3c 100644
--- a/arch/arm64/configs/vendor/xiaomi_QGKI.config
+++ b/arch/arm64/configs/vendor/xiaomi_QGKI.config
@@ -41,3 +41,9 @@ CONFIG_ICNSS2=m
 # CONFIG_ICNSS2_RESTART_LEVEL_NOTIF is not set
 CONFIG_CNSS2=m
 CONFIG_QCA_CLD_WLAN=m
+
+# TCP BBR Congestion Control
+CONFIG_TCP_CONG_ADVANCED=y
+CONFIG_TCP_CONG_BBR=y
+CONFIG_DEFAULT_BBR=y
+CONFIG_NET_SCH_FQ=y
-- 
2.55.0

